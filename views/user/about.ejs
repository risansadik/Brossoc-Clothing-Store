<%- include('../partials/user/header') %>

<style>
    .about-hero { background: var(--green); color: #fff; padding: 80px 24px; text-align: center; }
    .about-hero h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 16px; letter-spacing: -0.5px; }
    .about-hero p { font-size: 1.1rem; max-width: 600px; margin: 0 auto; opacity: 0.9; line-height: 1.6; }
    
    .about-section { max-width: 1000px; margin: 0 auto; padding: 64px 24px; }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; margin-bottom: 64px; }
    .about-grid:nth-child(even) { direction: rtl; }
    .about-grid:nth-child(even) > * { direction: ltr; }
    
    .about-img { aspect-ratio: 4/3; background: var(--bg); border-radius: 12px; overflow: hidden; }
    .about-img img { width: 100%; height: 100%; object-fit: cover; }
    
    .about-text h2 { font-size: 1.8rem; font-weight: 700; color: var(--text); margin-bottom: 16px; letter-spacing: -0.3px; }
    .about-text p { font-size: 1rem; color: var(--muted); line-height: 1.7; margin-bottom: 16px; }

    .stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; text-align: center; background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 40px; margin-bottom: 64px; }
    .stat-item h3 { font-size: 2.5rem; font-weight: 700; color: var(--green); margin-bottom: 4px; }
    .stat-item p { font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); }

    @media (max-width: 768px) {
        .about-grid { grid-template-columns: 1fr; gap: 32px; text-align: center; }
        .about-grid:nth-child(even) { direction: ltr; }
        .stats-row { grid-template-columns: 1fr; gap: 32px; padding: 32px 20px; }
    }
</style>

<div class="about-hero">
    <h1>Our Story</h1>
    <p>Redefining classic fashion with a modern twist. At Brossoc, we believe true style is timeless and quality is never compromised.</p>
</div>

<div class="about-section">
    <div class="about-grid">
        <div class="about-text">
            <h2>The Vision</h2>
            <p>Brossoc was founded on a simple premise: to bring the elegance of old-money fashion to the modern wardrobe. We curate pieces that stand the test of time, both in style and durability.</p>
            <p>Our commitment is to provide you with a premium shopping experience, offering a collection that embodies sophistication and understated luxury.</p>
        </div>
        <div class="about-img">
            <img src="https://res.cloudinary.com/brossoc/image/upload/v1785389021/brossoc-clothing/assets/bs5pwursxwukyormcidl.jpg" alt="Our Vision">
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-item"><h3>10k+</h3><p>Happy Customers</p></div>
        <div class="stat-item"><h3>100%</h3><p>Premium Quality</p></div>
        <div class="stat-item"><h3>24/7</h3><p>Support Access</p></div>
    </div>

    <div class="about-grid">
        <div class="about-img">
            <img src="https://res.cloudinary.com/brossoc/image/upload/v1785389023/brossoc-clothing/assets/ybrredgp6vnvz52umglg.jpg" alt="Quality Craftsmanship">
        </div>
        <div class="about-text">
            <h2>Uncompromising Quality</h2>
            <p>Every piece in our collection is carefully selected to ensure it meets our strict standards for quality, comfort, and design. We believe that true luxury lies in the details.</p>
            <p>Join us in celebrating fashion that doesn't just look good, but feels exceptional and lasts a lifetime.</p>
        </div>
    </div>
</div>

<%- include('../partials/user/footer') %>