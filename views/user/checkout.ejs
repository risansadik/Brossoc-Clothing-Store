<%- include('../partials/user/header') %>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<style>
    .checkout-section { max-width: 1200px; margin: 0 auto; padding: 60px 24px 80px; font-family: 'Inter', sans-serif; }
    .checkout-header { margin-bottom: 40px; border-bottom: 1px solid var(--border); padding-bottom: 24px; }
    .checkout-title { font-size: 2rem; font-weight: 500; color: var(--text); font-family: 'Playfair Display', serif; }
    
    .checkout-grid { display: grid; grid-template-columns: 1fr 380px; gap: 40px; align-items: start; }
    
    /* Left column */
    .ch-block { margin-bottom: 40px; }
    .ch-block-title { font-size: 1rem; font-weight: 600; margin-bottom: 20px; padding-bottom: 8px; color: var(--text); display: flex; justify-content: space-between; align-items: center; text-transform: uppercase; letter-spacing: 1px; }
    
    /* Addresses */
    .addr-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
    .addr-card { position: relative; border: 1px solid var(--border); padding: 20px; cursor: pointer; transition: all 0.2s; background: transparent; display: flex; gap: 16px; }
    .addr-card:hover { border-color: var(--text); }
    .addr-radio { margin-top: 4px; accent-color: var(--text); width: 16px; height: 16px; }
    .addr-info h5 { font-size: 0.95rem; font-weight: 600; margin-bottom: 6px; color: var(--text); text-transform: uppercase; letter-spacing: 0.5px; }
    .addr-info p { font-size: 0.85rem; color: var(--muted); line-height: 1.6; margin: 0; }
    .addr-type { position: absolute; top: 20px; right: 20px; font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; border: 1px solid var(--border); padding: 4px 8px; color: var(--muted); }
    .addr-selected { border-color: var(--text); border-width: 1.5px; }
    .addr-selected .addr-type { border-color: var(--text); color: var(--text); }
    
    /* Payment */
    .pm-card { border: 1px solid var(--border); padding: 20px; margin-bottom: 12px; cursor: pointer; transition: all 0.2s; background: transparent; display: flex; align-items: center; gap: 16px; }
    .pm-card:hover { border-color: var(--text); }
    .pm-card.pm-selected { border-color: var(--text); border-width: 1.5px; }
    .pm-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: var(--text); }
    .pm-info h5 { font-size: 0.95rem; font-weight: 600; margin: 0; color: var(--text); text-transform: uppercase; letter-spacing: 0.5px; }
    
    /* Right column (Summary) */
    .summary-card { background: var(--bg); padding: 40px 32px; position: sticky; top: 80px; }
    .summary-title { font-size: 1.2rem; font-weight: 500; font-family: 'Playfair Display', serif; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--border); text-transform: uppercase; letter-spacing: 1px; }
    
    .sum-item { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
    .sum-item-img { width: 50px; height: 65px; object-fit: cover; background: var(--white); }
    .sum-item-name { flex: 1; margin: 0 16px; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; }
    
    .sum-row { display: flex; justify-content: space-between; font-size: 0.85rem; margin-top: 24px; margin-bottom: 16px; color: var(--text); text-transform: uppercase; letter-spacing: 1px; font-weight: 500; }
    .sum-total { display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 600; color: var(--text); padding-top: 20px; border-top: 1px solid var(--border); margin-top: 8px; }
    
    .btn-place-order { width: 100%; padding: 16px; background: var(--text); color: #fff; border: none; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: background 0.3s; margin-top: 32px; font-family: inherit; }
    .btn-place-order:hover { background: var(--green); }
    
    /* Coupons */
    .coupon-box { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border); }
    .cpn-input-grp { display: flex; margin-bottom: 16px; border: 1px solid var(--border); }
    .cpn-input-grp input { flex: 1; padding: 12px 16px; border: none; background: transparent; font-family: inherit; font-size: 0.85rem; outline: none; text-transform: uppercase; }
    .btn-apply-cpn { padding: 0 20px; background: var(--text); color: #fff; border: none; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: background 0.2s; }
    .btn-apply-cpn:disabled { background: var(--border); color: var(--muted); cursor: not-allowed; }
    
    .cpn-list { display: flex; flex-direction: column; gap: 12px; max-height: 200px; overflow-y: auto; }
    .cpn-list::-webkit-scrollbar { display: none; }
    .cpn-card { border: 1px solid var(--border); padding: 16px; background: transparent; display: flex; justify-content: space-between; align-items: center; transition: border-color 0.2s; }
    .cpn-card:hover { border-color: var(--text); }
    .cpn-card-info h6 { font-size: 0.85rem; font-weight: 600; color: var(--text); margin: 0 0 4px; text-transform: uppercase; letter-spacing: 1px; }
    .cpn-card-info p { font-size: 0.75rem; color: var(--muted); margin: 0; }
    
    @media (max-width: 900px) { .checkout-grid { grid-template-columns: 1fr; } .summary-card { position: static; background: transparent; padding: 0; border-top: 1px solid var(--border); padding-top: 40px; margin-top: 40px; } }
</style>

<div class="checkout-section">
    <div class="checkout-header">
        <h1 class="checkout-title">Secure Checkout</h1>
    </div>

    <form id="checkoutForm">
        <div class="checkout-grid">
            
            <!-- Left Col -->
            <div>
                <!-- Addresses -->
                <div class="ch-block">
                    <div class="ch-block-title">
                        <span>1. Delivery Address</span>
                        <a href="/addAddress?returnTo=checkout" style="font-size:0.75rem;color:var(--text);text-decoration:underline;text-underline-offset:4px;font-weight:600;"><i class="fa-solid fa-plus"></i> Add New</a>
                    </div>
                    <% if (addresses && addresses.length > 0) { %>
                    <div class="addr-grid">
                        <% addresses.forEach((addr, idx) => { %>
                        <label class="addr-card <%= idx === 0 ? 'addr-selected' : '' %>" onclick="document.querySelectorAll('.addr-card').forEach(c=>c.classList.remove('addr-selected')); this.classList.add('addr-selected');">
                            <input type="radio" name="addressId" value="<%= addr._id %>" class="addr-radio" <%= idx === 0 ? 'checked' : '' %> required>
                            <div class="addr-info">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                                    <h5 style="margin-bottom:0;"><%= addr.name %></h5>
                                    <a href="/editAddress/<%= idx %>?returnTo=checkout" style="font-size:0.75rem;color:var(--muted);text-decoration:underline;text-underline-offset:3px; position:relative; z-index:2;">Edit</a>
                                </div>
                                <p><%= addr.landmark %>, <%= addr.city %><br><%= addr.state %> - <%= addr.pincode %><br>Phone: <%= addr.phone %></p>
                            </div>
                            <span class="addr-type"><%= addr.addressType %></span>
                        </label>
                        <% }); %>
                    </div>
                    <% } else { %>
                    <div style="background:#fffbeb;border:1px solid #fde68a;padding:16px;border-radius:8px;color:#d97706;font-size:0.9rem;">
                        No delivery addresses found.
                    </div>
                    <% } %>
                </div>

                <!-- Payment Methods -->
                <div class="ch-block">
                    <div class="ch-block-title">2. Payment Method</div>
                    <label class="pm-card pm-selected" onclick="document.querySelectorAll('.pm-card').forEach(c=>c.classList.remove('pm-selected')); this.classList.add('pm-selected');">
                        <input type="radio" name="paymentMethod" value="razorpay" class="addr-radio" checked required>
                        <div class="pm-icon"><i class="fa-solid fa-credit-card"></i></div>
                        <div class="pm-info"><h5>Razorpay (Cards, UPI, NetBanking)</h5></div>
                    </label>
                    <label class="pm-card" onclick="document.querySelectorAll('.pm-card').forEach(c=>c.classList.remove('pm-selected')); this.classList.add('pm-selected');">
                        <input type="radio" name="paymentMethod" value="wallet" class="addr-radio" required>
                        <div class="pm-icon"><i class="fa-solid fa-wallet"></i></div>
                        <div class="pm-info"><h5>Wallet Balance</h5></div>
                    </label>
                    <label class="pm-card" onclick="document.querySelectorAll('.pm-card').forEach(c=>c.classList.remove('pm-selected')); this.classList.add('pm-selected');">
                        <input type="radio" name="paymentMethod" value="cod" class="addr-radio" required>
                        <div class="pm-icon"><i class="fa-solid fa-money-bill"></i></div>
                        <div class="pm-info"><h5>Cash on Delivery</h5></div>
                    </label>
                </div>
            </div>

            <!-- Right Col (Summary) -->
            <div>
                <div class="summary-card">
                    <h3 class="summary-title">Order Summary</h3>
                    
                    <div style="margin-bottom:24px;max-height:300px;overflow-y:auto;">
                        <% cart.items.forEach(item => { %>
                        <div class="sum-item">
                            <img src="<%= (item.productId.productImage[0] && item.productId.productImage[0].startsWith('http')) ? item.productId.productImage[0] : '/uploads/product-images/' + item.productId.productImage[0] %>" class="sum-item-img">
                            <div class="sum-item-name">
                                <div style="font-size:0.85rem;"><%= item.productId.productName %></div>
                                <div style="font-size:0.75rem;color:var(--muted);">Size: <%= item.size %> | Qty: <%= item.quantity %></div>
                            </div>
                            <div style="font-weight:600;">₹<%= item.totalPrice %></div>
                        </div>
                        <% }); %>
                    </div>

                    <div class="sum-row">
                        <span>Subtotal</span>
                        <span>₹<%= cartTotal.toFixed(2) %></span>
                    </div>
                    
                    <div id="discountRow" class="sum-row" style="color:#10b981; <%= (appliedCoupon && appliedCoupon.discount) ? '' : 'display:none;' %>">
                        <span>Discount</span>
                        <span id="discountAmount">-₹<%= (appliedCoupon && appliedCoupon.discount) ? appliedCoupon.discount.toFixed(2) : '0.00' %></span>
                    </div>

                    <div class="sum-row">
                        <span>Shipping</span>
                        <span style="color:#10b981;">Free</span>
                    </div>
                    
                    <div class="sum-total">
                        <span>Total</span>
                        <span id="finalAmount">₹<%= finalAmount.toFixed(2) %></span>
                    </div>

                    <button type="submit" class="btn-place-order" id="btnPlaceOrder">Place Order</button>

                    <!-- Coupons -->
                    <div class="coupon-box">
                        <h4 style="font-size:0.9rem;font-weight:700;margin-bottom:12px;">Apply Coupon</h4>
                        <div class="cpn-input-grp">
                            <input type="text" name="couponCode" id="couponCode" placeholder="Enter code">
                            <button type="button" class="btn-apply-cpn" id="btnApplyCpn" disabled>Apply</button>
                        </div>
                        <button type="button" id="btnRemoveCpn" style="width:100%;padding:8px;background:none;border:1px solid #ef4444;color:#ef4444;border-radius:8px;font-size:0.85rem;font-weight:600;cursor:pointer;margin-bottom:16px; <%= (appliedCoupon && appliedCoupon.discount) ? '' : 'display:none;' %>">Remove Applied Coupon</button>
                        
                        <% if (locals.coupons && coupons.length > 0) { %>
                        <div style="font-size:0.8rem;color:var(--text);margin-bottom:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;">Available Offers</div>
                        <div class="cpn-list">
                            <% coupons.forEach(cpn => { %>
                                <% if (!cpn.isUsed) { %>
                                <div class="cpn-card" style="<%= !cpn.isEligible ? 'opacity:0.65;background:#f9fafb;border-color:transparent;' : '' %>">
                                    <div class="cpn-card-info">
                                        <h6 style="<%= !cpn.isEligible ? 'color:var(--muted);' : '' %>"><%= cpn.code %></h6>
                                        <p>
                                            <% if (cpn.discountPercentage) { %>
                                                <%= cpn.discountPercentage %>% OFF up to ₹<%= cpn.maximumPurchase %>
                                            <% } else { %>
                                                Flat ₹<%= cpn.offerPrice %> OFF
                                            <% } %>
                                            on orders above ₹<%= cpn.minimumPurchase %>
                                        </p>
                                        <% if (!cpn.isEligible && cartTotal < cpn.minimumPurchase) { %>
                                            <p style="color:#b91c1c;font-weight:700;margin-top:6px;font-size:0.7rem;letter-spacing:0.3px;">
                                                Add ₹<%= (cpn.minimumPurchase - cartTotal).toFixed(2) %> more to unlock!
                                            </p>
                                        <% } %>
                                    </div>
                                    <button type="button" class="btn-apply-cpn" style="padding:6px 12px;font-size:0.75rem;" 
                                        <%= !cpn.isEligible ? 'disabled' : '' %>
                                        onclick="document.getElementById('couponCode').value='<%= cpn.code %>'; document.getElementById('btnApplyCpn').disabled=false;">
                                        <%= cpn.isEligible ? 'Use' : 'Locked' %>
                                    </button>
                                </div>
                                <% } %>
                            <% }); %>
                        </div>
                        <% } %>
                    </div>

                </div>
            </div>
            
        </div>
    </form>
</div>

<%- include('../partials/user/footer') %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Form Submit Logic
        const form = document.getElementById('checkoutForm');
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const addrRadio = document.querySelector('input[name="addressId"]:checked');
            if (!addrRadio) { Swal.fire({icon: 'warning', title: 'Address Required', text: 'Please add/select a delivery address.', confirmButtonColor: '#111111'}); return; }
            
            const addrId = addrRadio.value;
            const pm = document.querySelector('input[name="paymentMethod"]:checked').value;
            
            if (pm === 'cod' || pm === 'wallet') {
                try {
                    Swal.fire({title: 'Processing...', allowOutsideClick: false, showConfirmButton: false, didOpen: () => Swal.showLoading()});
                    const res = await fetch('/process-checkout', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ addressId: addrId, paymentMethod: pm }) });
                    const result = await res.json();
                    if (result.success) {
                        Swal.fire({icon: 'success', title: 'Order Placed!', text: 'Your order has been placed successfully.', showCancelButton: true, confirmButtonText: 'View Orders', confirmButtonColor: '#111111', cancelButtonText: 'Continue Shopping', cancelButtonColor: '#6b7280'})
                        .then(r => { if (r.isConfirmed) window.location.href = '/orders'; else window.location.href = '/shop'; });
                    } else { Swal.fire({icon: 'error', title: 'Order Failed', text: result.message, confirmButtonColor: '#111111'}); }
                } catch(err) { Swal.fire({icon: 'error', title: 'Error', text: 'Failed to process order.', confirmButtonColor: '#111111'}); }
            } else if (pm === 'razorpay') {
                try {
                    Swal.fire({title: 'Initializing Payment...', allowOutsideClick: false, showConfirmButton: false, didOpen: () => Swal.showLoading()});
                    const rzpRes = await fetch('/create-razorpay-order', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ addressId: addrId }) });
                    const rzpData = await rzpRes.json();
                    if (!rzpData.success) throw new Error(rzpData.message);
                    
                    Swal.close();
                    
                    const options = {
                        key: rzpData.key, amount: rzpData.order.amount, currency: rzpData.order.currency,
                        name: 'Brossoc', description: 'Order Payment', order_id: rzpData.order.id,
                        handler: async function(response) {
                            try {
                                Swal.fire({title: 'Verifying...', allowOutsideClick: false, showConfirmButton: false, didOpen: () => Swal.showLoading()});
                                const vRes = await fetch('/verify-payment', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(response) });
                                const vResult = await vRes.json();
                                if (vResult.success) {
                                    Swal.fire({icon: 'success', title: 'Payment Successful!', showCancelButton: true, confirmButtonText: 'View Orders', confirmButtonColor: '#111111', cancelButtonText: 'Continue Shopping', cancelButtonColor: '#6b7280'})
                                    .then(r => { if (r.isConfirmed) window.location.href = '/orders'; else window.location.href = '/shop'; });
                                } else throw new Error(vResult.message);
                            } catch(err) { Swal.fire({icon: 'error', title: 'Verification Failed', text: err.message, confirmButtonColor: '#111111'}); }
                        },
                        prefill: { name: '<%= locals.user ? user.name : "" %>', email: '<%= locals.user ? user.email : "" %>', contact: '<%= locals.user ? user.phone : "" %>' },
                        theme: { color: '#111111' },
                        modal: { ondismiss: function() { Swal.fire({icon: 'warning', title: 'Cancelled', text: 'Payment was cancelled.', confirmButtonColor: '#111111'}); } }
                    };
                    const rzp = new Razorpay(options);
                    rzp.on('payment.failed', function(response) {
                        Swal.fire({icon: 'error', title: 'Payment Failed', text: 'Please try again.', confirmButtonColor: '#111111'});
                    });
                    rzp.open();
                } catch(err) { Swal.fire({icon: 'error', title: 'Error', text: err.message || 'Failed to initialize payment.', confirmButtonColor: '#111111'}); }
            }
        });

        // Coupon Logic
        const cpnInput = document.getElementById('couponCode');
        const btnApply = document.getElementById('btnApplyCpn');
        const btnRemove = document.getElementById('btnRemoveCpn');
        
        cpnInput.addEventListener('input', (e) => { btnApply.disabled = !e.target.value.trim(); });
        
        btnApply.addEventListener('click', () => {
            const code = cpnInput.value.trim();
            if(!code) return;
            $.ajax({
                url: '/apply-coupon', method: 'POST', contentType: 'application/json',
                data: JSON.stringify({ couponCode: code }),
                success: function(res) {
                    if (res.success) {
                        Swal.fire({icon: 'success', title: 'Applied!', text: res.message, toast: true, position: 'top-end', showConfirmButton: false, timer: 2000});
                        btnRemove.style.display = 'block';
                        if (res.data) {
                            document.getElementById('finalAmount').textContent = `₹${res.data.finalTotal.toFixed(2)}`;
                            document.getElementById('discountRow').style.display = 'flex';
                            document.getElementById('discountAmount').textContent = `-₹${res.data.discount.toFixed(2)}`;
                        }
                    } else { Swal.fire({icon: 'error', title: 'Error', text: res.message || 'Invalid coupon', confirmButtonColor: '#111111'}); }
                }
            });
        });

        btnRemove.addEventListener('click', () => {
            $.ajax({
                url: '/remove-coupon', method: 'POST', contentType: 'application/json',
                success: function(res) {
                    if(res.success) {
                        Swal.fire({icon: 'success', title: 'Removed', text: 'Coupon removed', toast: true, position: 'top-end', showConfirmButton: false, timer: 2000});
                        cpnInput.value = ''; btnApply.disabled = true; btnRemove.style.display = 'none';
                        if (res.data) {
                            document.getElementById('finalAmount').textContent = `₹${res.data.finalTotal.toFixed(2)}`;
                            document.getElementById('discountRow').style.display = 'none';
                        }
                    }
                }
            });
        });
    });
</script>