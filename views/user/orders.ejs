<%- include('../../views/partials/user/profilePartials/header.ejs') %>
<% if(false) { %><!-- VSCode Linter Trick --><html><body><div class="profile-layout"><main class="profile-main"><% } %>

<style>
    :root { --green: #4a5225; --bg: #f4f5f3; --white: #fff; --border: #e2e5e0; --text: #1a1a1a; --muted: #6b7280; }
    .orders-wrap { overflow-x: auto; }
    .orders-table { width: 100%; border-collapse: collapse; min-width: 640px; }
    .orders-table th { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); padding: 12px 16px; border-bottom: 2px solid var(--border); text-align: left; background: var(--bg); }
    .orders-table td { padding: 14px 16px; border-bottom: 1px solid var(--border); vertical-align: middle; font-size: 0.9rem; }
    .orders-table tr:last-child td { border-bottom: none; }
    .orders-table tr:hover td { background: #fafafa; }
    .product-cell { display: flex; align-items: center; gap: 12px; }
    .product-cell img { width: 52px; height: 52px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); flex-shrink: 0; }
    .prod-name { font-weight: 500; font-size: 0.88rem; color: var(--text); }
    .prod-meta { font-size: 0.78rem; color: var(--muted); margin-top: 2px; }
    .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; color: #fff; }
    .badge-pending { background: #f59e0b; }
    .badge-processing { background: #3b82f6; }
    .badge-shipped { background: var(--green); }
    .badge-delivered { background: #10b981; }
    .badge-cancelled { background: #ef4444; }
    .badge-return-request { background: #f97316; }
    .badge-returned { background: #8b5cf6; }
    .btn-view { padding: 7px 14px; background: transparent; border: 1px solid var(--border); border-radius: 6px; font-family: inherit; font-size: 0.82rem; font-weight: 600; color: var(--text); cursor: pointer; transition: all 0.2s; }
    .btn-view:hover { border-color: var(--green); color: var(--green); background: #f2f4eb; }
    .price-col { font-weight: 600; color: var(--text); }
    .price-col .discount { font-size: 0.78rem; color: #10b981; font-weight: 400; }
    .empty-state { text-align: center; padding: 48px 20px; color: var(--muted); }
    .empty-state i { font-size: 2.2rem; margin-bottom: 14px; display: block; }
    .empty-state a { color: var(--green); font-weight: 600; text-decoration: none; }
    /* Pagination */
    .pgn { display: flex; justify-content: center; gap: 6px; margin-top: 20px; }
    .pgn a, .pgn span { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 6px; font-size: 0.85rem; font-weight: 500; border: 1px solid var(--border); color: var(--text); text-decoration: none; transition: all 0.2s; background: var(--white); }
    .pgn a:hover { border-color: var(--green); color: var(--green); }
    .pgn .active-page { background: var(--green); color: #fff; border-color: var(--green); }
    .pgn .disabled-page { opacity: 0.4; pointer-events: none; }
</style>

<h2 class="page-title">My Orders</h2>

<div class="card" style="padding: 0; overflow:hidden;">
    <% if (orders && orders.length > 0) { %>
    <div class="orders-wrap">
        <table class="orders-table">
            <thead>
                <tr>
                    <th>Order Info</th>
                    <th>Items</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                <tr>
                    <td>
                        <div style="font-weight:600;font-size:0.82rem;">Order #<%= order.orderId %></div>
                        <div style="font-size:0.78rem;color:var(--muted);margin-top:3px;"><%= new Date(order.createdOn).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
                    </td>
                    <td>
                        <% order.orderedItems.forEach(item => { %>
                        <div class="product-cell" style="margin-bottom:8px; cursor: pointer;" onclick="goToProduct('<%= item.product?._id || '' %>')">
                            <img src="<%= (item.product && item.product.productImage && item.product.productImage[0] && item.product.productImage[0].startsWith('http')) ? item.product.productImage[0] : '/uploads/product-images/' + (item.product?.productImage?.[0] || 'default.jpg') %>"
                                alt="<%= item.product?.productName || 'Product' %>"
                                onerror="this.style.display='none'">
                            <div>
                                <div class="prod-name" style="text-decoration: underline; text-underline-offset: 2px;"><%= item.product?.productName || 'Product Unavailable' %></div>
                                <div class="prod-meta">Qty: <%= item.quantity %> &middot; ₹<%= item.price %></div>
                            </div>
                        </div>
                        <% }); %>
                    </td>
                    <td>
                        <div class="price-col">₹<%= order.finalAmount %></div>
                        <% if (order.discount > 0) { %><div class="discount">−₹<%= order.discount %> off</div><% } %>
                    </td>
                    <td>
                        <span class="badge badge-<%= order.status.toLowerCase().replace(/\s+/g, '-') %>"><%= order.status %></span>
                    </td>
                    <td>
                        <button onclick="viewOrderDetails('<%= order.orderId %>')" class="btn-view">Details</button>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <% } else { %>
    <div class="empty-state">
        <i class="fa-regular fa-bag-shopping"></i>
        <p style="margin-bottom:6px;">No orders yet.</p>
        <a href="/shop">Start shopping</a>
    </div>
    <% } %>
</div>

<% if (pagination && pagination.totalPages > 1) { %>
<div class="pgn">
    <a href="<%= !pagination.hasPreviousPage ? '#' : '/orders?page=' + pagination.previousPage %>" class="<%= !pagination.hasPreviousPage ? 'disabled-page' : '' %>"><i class="fa-solid fa-angle-left"></i></a>
    <% for(let i = 1; i <= pagination.totalPages; i++) { %>
    <a href="/orders?page=<%= i %>" class="<%= i === pagination.currentPage ? 'active-page' : '' %>"><%= i %></a>
    <% } %>
    <a href="<%= !pagination.hasNextPage ? '#' : '/orders?page=' + pagination.nextPage %>" class="<%= !pagination.hasNextPage ? 'disabled-page' : '' %>"><i class="fa-solid fa-angle-right"></i></a>
</div>
<% } %>

<script>

    function viewOrderDetails(orderId) {
        if (!orderId) return;
        window.location.href = `/orders/${orderId}`;
    }

    async function goToProduct(productId) {
        if (!productId || productId === 'undefined') {
            Swal.fire({ title: 'Product Unavailable', text: 'This product has been removed from our catalog.', icon: 'error', confirmButtonColor: '#111111' });
            return;
        }
        try {
            const response = await fetch(`/productDetails?id=${productId}`, { method: 'HEAD' });
            if (response.redirected && response.url.includes('/shop')) {
                Swal.fire({ title: 'Product Unavailable', text: 'This product is currently unavailable or out of stock.', icon: 'error', confirmButtonColor: '#111111' });
            } else {
                window.location.href = `/productDetails?id=${productId}`;
            }
        } catch (e) {
            window.location.href = `/productDetails?id=${productId}`;
        }
    }
</script>

        </main>
    </div>
</body>
</html>