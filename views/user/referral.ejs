<%- include('../../views/partials/user/profilePartials/header.ejs') %>
<% if(false) { %><!-- VSCode Linter Trick --><html><body><div class="profile-layout"><main class="profile-main"><% } %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.css">


<style>
    :root { --green: #4a5225; --bg: #f4f5f3; --white: #fff; --border: #e2e5e0; --text: #1a1a1a; --muted: #6b7280; }
    .referral-hero { background: var(--green); color: #fff; border-radius: 10px; padding: 32px 24px; text-align: center; margin-bottom: 20px; }
    .referral-hero h2 { font-size: 1.3rem; font-weight: 700; margin-bottom: 6px; }
    .referral-hero p { opacity: 0.8; font-size: 0.9rem; margin-bottom: 24px; }
    .code-box { display: flex; align-items: center; justify-content: center; gap: 10px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); border-radius: 8px; padding: 12px 20px; max-width: 320px; margin: 0 auto; }
    .code-text { font-size: 1.1rem; font-weight: 700; letter-spacing: 3px; }
    .btn-copy { background: #fff; color: var(--green); border: none; border-radius: 6px; padding: 8px 14px; font-family: inherit; font-size: 0.82rem; font-weight: 700; cursor: pointer; transition: opacity 0.2s; }
    .btn-copy:hover { opacity: 0.9; }
    .stats-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 20px; }
    .stat-card { background: var(--white); border: 1px solid var(--border); border-radius: 10px; padding: 20px; text-align: center; }
    .stat-card .s-val { font-size: 1.6rem; font-weight: 700; color: var(--green); }
    .stat-card .s-lbl { font-size: 0.78rem; color: var(--muted); font-weight: 500; margin-top: 4px; }
    .progress-track { height: 6px; background: var(--border); border-radius: 3px; margin: 8px 0 4px; overflow: hidden; }
    .progress-fill { height: 100%; background: var(--green); border-radius: 3px; transition: width 0.5s; }
    .how-it-works { padding: 20px; }
    .how-it-works h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 16px; }
    .step { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px; }
    .step-num { width: 28px; height: 28px; border-radius: 50%; background: #f2f4eb; color: var(--green); font-size: 0.8rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .step-text { font-size: 0.88rem; color: var(--text); line-height: 1.5; }
    .step-text strong { color: var(--green); }
</style>

<h2 class="page-title">Referral Program</h2>

<div class="referral-hero">
    <h2>Invite Friends, Earn Rewards</h2>
    <p>Earn ₹100 wallet credit for every friend who signs up using your code</p>
    <div class="code-box">
        <span class="code-text"><%= referralCode %></span>
        <button class="btn-copy" onclick="copyCode()"><i class="fa-regular fa-copy"></i> Copy</button>
    </div>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div class="s-val"><%= referralCount %></div>
        <div class="s-lbl">Successful Referrals</div>
        <div class="progress-track"><div class="progress-fill" style="width:<%= Math.min((referralCount / 10) * 100, 100) %>%"></div></div>
        <div style="font-size:0.72rem;color:var(--muted);"><%= referralCount %>/10 for next tier</div>
    </div>
    <div class="stat-card">
        <div class="s-val">₹<%= (wallet || 0).toFixed(0) %></div>
        <div class="s-lbl">Wallet Balance Earned</div>
    </div>
</div>

<div class="card" style="padding:0;overflow:hidden;">
    <div class="how-it-works">
        <h3>How it works</h3>
        <div class="step"><div class="step-num">1</div><div class="step-text">Share your referral code with friends</div></div>
        <div class="step"><div class="step-num">2</div><div class="step-text">Friend signs up using your code</div></div>
        <div class="step"><div class="step-num">3</div><div class="step-text">You both earn <strong>₹100</strong> in wallet credits</div></div>
    </div>
</div>

<script>

    function copyCode() {
        const code = '<%= referralCode %>';
        navigator.clipboard.writeText(code).then(() => {
            Swal.fire({ icon: 'success', title: 'Copied!', text: code, showConfirmButton: false, timer: 1500, toast: true, position: 'top-end' });
        }).catch(() => {
            const el = document.createElement('textarea'); el.value = code; document.body.appendChild(el); el.select(); document.execCommand('copy'); document.body.removeChild(el);
            Swal.fire({ icon: 'success', title: 'Copied!', showConfirmButton: false, timer: 1200, toast: true, position: 'top-end' });
        });
    }
</script>

        </main>
    </div>
</body>
</html>