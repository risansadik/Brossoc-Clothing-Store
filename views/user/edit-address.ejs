<%- include('../../views/partials/user/profilePartials/header.ejs') %>
<% if(false) { %><!-- VSCode Linter Trick --><html><body><div class="profile-layout"><main class="profile-main"><% } %>

<link href="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/11.7.32/sweetalert2.min.css" rel="stylesheet">


<style>
    :root { --green: #4a5225; --bg: #f4f5f3; --white: #fff; --border: #e2e5e0; --text: #1a1a1a; --muted: #6b7280; --danger: #dc2626; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group.full { grid-column: 1/-1; }
    .form-group label { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
    .form-group label .req { color: var(--danger); }
    .form-group input { padding: 11px 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); font-family: inherit; font-size: 0.93rem; transition: border-color 0.2s, box-shadow 0.2s; }
    .form-group input:focus { outline: none; border-color: var(--green); background: var(--white); box-shadow: 0 0 0 3px rgba(59,93,80,0.1); }
    .form-group input.error { border-color: var(--danger); }
    .error-message { color: var(--danger); font-size: 0.75rem; display: none; }
    .btn-row { display: flex; gap: 10px; margin-top: 20px; }
    .btn-save { padding: 11px 24px; background: var(--green); color: #fff; border: none; border-radius: 8px; font-family: inherit; font-size: 0.93rem; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .btn-save:hover { background: #3a411d; }
    .btn-cancel { padding: 11px 20px; background: transparent; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.93rem; font-weight: 500; color: var(--muted); text-decoration: none; cursor: pointer; }
    @media (max-width: 520px) { .form-grid { grid-template-columns: 1fr; } .form-group.full { grid-column: 1; } }
</style>

<h2 class="page-title">Edit Address</h2>

<div class="card">
    <form id="edit-address-form" onsubmit="return false;">
        <input type="hidden" id="addressIndex" name="addressIndex" value="<%= addressIndex %>">
        <div class="form-grid">
            <div class="form-group">
                <label>Address Type <span class="req">*</span></label>
                <input type="text" id="addressType" name="addressType" value="<%= typeof addressType !== 'undefined' ? addressType : '' %>" placeholder="Home, Work, etc.">
                <div class="error-message">This field cannot be empty</div>
            </div>
            <div class="form-group">
                <label>Full Name <span class="req">*</span></label>
                <input type="text" id="name" name="name" value="<%= typeof name !== 'undefined' ? name : '' %>" placeholder="Recipient's name">
                <div class="error-message">This field cannot be empty</div>
            </div>
            <div class="form-group full">
                <label>Street Address / Landmark <span class="req">*</span></label>
                <input type="text" id="streetAddress" name="streetAddress" value="<%= typeof streetAddress !== 'undefined' ? streetAddress : '' %>">
                <div class="error-message">This field cannot be empty</div>
            </div>
            <div class="form-group">
                <label>City <span class="req">*</span></label>
                <input type="text" id="city" name="city" value="<%= typeof city !== 'undefined' ? city : '' %>">
                <div class="error-message">This field cannot be empty</div>
            </div>
            <div class="form-group">
                <label>State <span class="req">*</span></label>
                <input type="text" id="state" name="state" value="<%= typeof state !== 'undefined' ? state : '' %>">
                <div class="error-message">This field cannot be empty</div>
            </div>
            <div class="form-group">
                <label>PIN Code <span class="req">*</span></label>
                <input type="text" id="pinCode" name="pinCode" value="<%= typeof pinCode !== 'undefined' ? pinCode : '' %>" placeholder="6-digit PIN">
                <div class="error-message">Enter a valid 6-digit PIN code</div>
            </div>
            <div class="form-group">
                <label>Phone Number <span class="req">*</span></label>
                <input type="tel" id="phoneNumber" name="phoneNumber" value="<%= typeof phoneNumber !== 'undefined' ? phoneNumber : '' %>">
                <div class="error-message">Enter a valid 10-digit phone number</div>
            </div>
            <div class="form-group">
                <label>Alternative Phone</label>
                <input type="tel" id="alternativePhone" name="alternativePhone" value="<%= typeof alternativePhone !== 'undefined' ? alternativePhone : '' %>">
                <div class="error-message">Enter a valid 10-digit phone number</div>
            </div>
        </div>
        <div class="btn-row">
            <button type="submit" class="btn-save" onclick="validateForm(event)">Update Address</button>
            <a href="<%= typeof returnTo !== 'undefined' && returnTo === 'checkout' ? '/checkout' : '/addresses' %>" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>

<script>

    function validateForm(event) {
        event.preventDefault();
        let isValid = true;
        const form = document.getElementById('edit-address-form');
        const inputs = form.querySelectorAll('input[type="text"], input[type="tel"]');
        inputs.forEach(input => {
            if (!input.nextElementSibling || !input.nextElementSibling.classList.contains('error-message')) return;
            input.classList.remove('error'); input.nextElementSibling.style.display = 'none';
            if (input.value.trim() === '' && input.id !== 'alternativePhone') { 
                input.classList.add('error'); 
                input.nextElementSibling.innerHTML = 'This field cannot be empty';
                input.nextElementSibling.style.display = 'block'; 
                isValid = false; 
            } else if (input.value.trim() !== '') {
                if (['name', 'addressType', 'city', 'state'].includes(input.id) && !/^[A-Za-z\s]+$/.test(input.value.trim())) {
                    input.classList.add('error');
                    input.nextElementSibling.innerHTML = 'Only letters and spaces allowed';
                    input.nextElementSibling.style.display = 'block';
                    isValid = false;
                }
                if (input.id === 'pinCode' && !/^\d{6}$/.test(input.value)) { 
                    input.classList.add('error'); 
                    input.nextElementSibling.innerHTML = 'Enter a valid 6-digit PIN code';
                    input.nextElementSibling.style.display = 'block'; 
                    isValid = false; 
                }
                if (input.id === 'phoneNumber' && !/^\d{10}$/.test(input.value)) { 
                    input.classList.add('error'); 
                    input.nextElementSibling.innerHTML = 'Enter a valid 10-digit phone number';
                    input.nextElementSibling.style.display = 'block'; 
                    isValid = false; 
                }
                if (input.id === 'alternativePhone' && !/^\d{10}$/.test(input.value)) { 
                    input.classList.add('error'); 
                    input.nextElementSibling.innerHTML = 'Enter a valid 10-digit phone number';
                    input.nextElementSibling.style.display = 'block'; 
                    isValid = false; 
                }
            }
        });
        if (isValid) {
            const formData = {
                name: document.getElementById('name').value, addressType: document.getElementById('addressType').value,
                streetAddress: document.getElementById('streetAddress').value, city: document.getElementById('city').value,
                state: document.getElementById('state').value, pinCode: document.getElementById('pinCode').value,
                phoneNumber: document.getElementById('phoneNumber').value, alternativePhone: document.getElementById('alternativePhone').value,
                addressIndex: document.getElementById('addressIndex').value
            };
            fetch('/updateAddress', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(formData) })
            .then(async response => {
                const result = await response.json();
                if (response.ok) { 
                    const redirectUrl = "<%= typeof returnTo !== 'undefined' && returnTo === 'checkout' ? '/checkout' : '/addresses' %>";
                    Swal.fire({ title: 'Updated!', text: 'Address updated successfully', icon: 'success', allowOutsideClick: false }).then(() => window.location.replace(redirectUrl)); 
                }
                else { Swal.fire({ title: 'Error!', text: result.message || 'Failed to update address', icon: 'error' }); }
            }).catch(() => Swal.fire({ title: 'Error!', text: 'Something went wrong', icon: 'error' }));
        }
    }
    document.getElementById('edit-address-form').addEventListener('submit', validateForm);
    document.querySelectorAll('input').forEach(input => {
        input.addEventListener('input', function () { if (this.value.trim()) { this.classList.remove('error'); if (this.nextElementSibling?.classList.contains('error-message')) this.nextElementSibling.style.display = 'none'; } });
    });
</script>

        </main>
    </div>
</body>
</html>