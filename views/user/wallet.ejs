<%- include('../../views/partials/user/profilePartials/header.ejs') %>
<% if(false) { %><!-- VSCode Linter Trick --><html><body><div class="profile-layout"><main class="profile-main"><% } %>

<style>
    :root { --green: #4a5225; --bg: #f4f5f3; --white: #fff; --border: #e2e5e0; --text: #1a1a1a; --muted: #6b7280; }
    .wallet-balance-card { background: var(--green); color: #fff; border-radius: 10px; padding: 28px 24px; margin-bottom: 20px; }
    .wallet-balance-card .w-label { font-size: 0.82rem; font-weight: 500; opacity: 0.8; margin-bottom: 6px; }
    .wallet-balance-card .w-amount { font-size: 2.4rem; font-weight: 700; letter-spacing: -1px; margin-bottom: 6px; }
    .wallet-balance-card .w-note { font-size: 0.78rem; opacity: 0.6; }
    .tx-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--border); }
    .tx-header h3 { font-size: 0.95rem; font-weight: 700; }
    .tx-item { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid var(--border); }
    .tx-item:last-child { border-bottom: none; }
    .tx-left { display: flex; align-items: center; gap: 14px; min-width: 0; flex: 1; }
    .tx-left-text { min-width: 0; flex: 1; }
    .tx-icon { width: 36px; height: 36px; border-radius: 50%; background: var(--bg); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0; }
    .tx-icon.credit { background: #d1fae5; color: #10b981; }
    .tx-icon.debit { background: #fee2e2; color: #ef4444; }
    .tx-desc { font-size: 0.88rem; font-weight: 500; color: var(--text); word-wrap: break-word; overflow-wrap: break-word; }
    .tx-date { font-size: 0.75rem; color: var(--muted); margin-top: 2px; }
    .tx-amount { font-weight: 700; font-size: 0.95rem; white-space: nowrap; flex-shrink: 0; margin-left: 12px; }
    .tx-amount.credit { color: #10b981; }
    .tx-amount.debit { color: #ef4444; }
    .empty-tx { text-align: center; padding: 32px; color: var(--muted); font-size: 0.9rem; }
    .pgn-sm { display: flex; justify-content: center; gap: 8px; padding: 12px; }
    .pgn-sm a, .pgn-sm span { padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.82rem; font-weight: 500; color: var(--text); text-decoration: none; background: var(--white); }
    .pgn-sm span { background: var(--green); color: #fff; border-color: var(--green); }
    @media (max-width: 480px) {
        .wallet-balance-card { padding: 20px 16px; }
        .wallet-balance-card .w-amount { font-size: 2rem; }
        .tx-item { padding: 12px 14px; }
        .tx-left { gap: 10px; }
    }
</style>

<h2 class="page-title">Wallet</h2>

<div class="wallet-balance-card">
    <div class="w-label">Available Balance</div>
    <div class="w-amount">₹<%= (wallet?.balance || 0).toFixed(2) %></div>
    <div class="w-note">Balance can only be used for purchases or received from refunds</div>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
    <div class="tx-header">
        <h3>Transactions</h3>
    </div>

    <% if (wallet?.transactions?.length > 0) { %>
        <% wallet.transactions.forEach(transaction => { %>
        <div class="tx-item">
            <div class="tx-left">
                <div class="tx-icon <%= transaction.type === 'credit' ? 'credit' : 'debit' %>">
                    <i class="fa-solid <%= transaction.type === 'credit' ? 'fa-arrow-down-left' : 'fa-arrow-up-right' %>"></i>
                </div>
                <div class="tx-left-text">
                    <div class="tx-desc"><%= transaction.description || 'Transaction' %></div>
                    <div class="tx-date"><%= new Date(transaction.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %></div>
                </div>
            </div>
            <div class="tx-amount <%= transaction.type === 'credit' ? 'credit' : 'debit' %>">
                <%= transaction.type === 'credit' ? '+' : '−' %>₹<%= (transaction.amount || 0).toFixed(2) %>
            </div>
        </div>
        <% }); %>

        <% if (wallet.pagination && wallet.pagination.totalPages > 1) { %>
        <div class="pgn-sm">
            <% if (wallet.pagination.hasPrevPage) { %>
            <a href="/wallet?page=<%= wallet.pagination.currentPage - 1 %>"><i class="fa-solid fa-chevron-left"></i></a>
            <% } %>
            <span><%= wallet.pagination.currentPage %> of <%= wallet.pagination.totalPages %></span>
            <% if (wallet.pagination.hasNextPage) { %>
            <a href="/wallet?page=<%= wallet.pagination.currentPage + 1 %>"><i class="fa-solid fa-chevron-right"></i></a>
            <% } %>
        </div>
        <% } %>
    <% } else { %>
    <div class="empty-tx">No transactions yet.</div>
    <% } %>
</div>

<script>
</script>

        </main>
    </div>
</body>
</html>