<%- include('../partials/user/header') %>


<style>
    .pd-section { max-width: 1200px; margin: 0 auto; padding: 48px 24px 64px; }
    .pd-grid { display: grid; grid-template-columns: 420px 1fr; gap: 48px; }
    
    /* Gallery */
    .pd-gallery { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 100px; }
    .pd-main-img { position: relative; aspect-ratio: 4/5; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; cursor: crosshair; }
    .pd-main-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.1s ease-out; }
    .pd-main-img.zoomed img { transform: scale(2.2); }
    .gal-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; background: rgba(255,255,255,0.9); border: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text); box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: background 0.2s; z-index: 10; }
    .gal-nav:hover { background: #fff; }
    .gal-nav.prev { left: 16px; }
    .gal-nav.next { right: 16px; }
    .pd-thumbs { display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; }
    .pd-thumbs::-webkit-scrollbar { display: none; }
    .pd-thumb { width: 80px; height: 80px; flex-shrink: 0; background: var(--bg); border: 2px solid transparent; border-radius: 8px; cursor: pointer; overflow: hidden; transition: border-color 0.2s; }
    .pd-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .pd-thumb.active { border-color: var(--green); }

    /* Info */
    .pd-info { display: flex; flex-direction: column; gap: 24px; padding-top: 10px; }
    .pd-title { font-size: 2rem; font-weight: 700; line-height: 1.2; letter-spacing: -0.5px; color: var(--text); margin-bottom: 8px; }
    .pd-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
    .pd-sale { font-size: 1.6rem; font-weight: 700; color: var(--green); }
    .pd-reg { font-size: 1.1rem; color: var(--muted); text-decoration: line-through; }
    .pd-badge { background: #ef4444; color: #fff; font-size: 0.75rem; font-weight: 700; padding: 4px 8px; border-radius: 6px; }
    
    .pd-desc { font-size: 0.95rem; line-height: 1.6; color: var(--muted); margin-bottom: 8px; }
    
    /* Options */
    .pd-opt-group { display: flex; flex-direction: column; gap: 8px; }
    .pd-opt-label { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text); }
    .pd-select { appearance: none; -webkit-appearance: none; background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%231a1a1a%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right 14px top 50%; background-size: 10px auto; width: 100%; max-width: 320px; padding: 12px 36px 12px 14px; border: 1px solid var(--border); border-radius: 8px; background-color: var(--white); font-family: inherit; font-size: 0.93rem; color: var(--text); outline: none; cursor: pointer; }
    .pd-select:focus { border-color: var(--green); }
    
    /* Actions */
    .pd-action-row { display: flex; gap: 16px; align-items: flex-end; margin-top: 16px; }
    .qty-wrap { display: flex; flex-direction: column; gap: 8px; }
    .pd-qty-ctrl { display: inline-flex; align-items: center; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; background: var(--white); height: 46px; }
    .pd-qty-ctrl button { width: 40px; height: 100%; background: none; border: none; font-size: 1.1rem; cursor: pointer; color: var(--text); transition: background 0.2s; }
    .pd-qty-ctrl button:hover { background: var(--bg); }
    .pd-qty-ctrl input { width: 40px; height: 100%; text-align: center; border: none; background: none; font-weight: 600; font-size: 0.95rem; pointer-events: none; }
    
    .btn-add-cart { flex: 1; height: 46px; background: var(--green); color: #fff; border: none; border-radius: 8px; font-family: inherit; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .btn-add-cart:hover:not(:disabled) { background: var(--green-dark); }
    .btn-add-cart:disabled { background: var(--border); color: var(--muted); cursor: not-allowed; }
    
    .btn-wishlist { width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; background: var(--white); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 1.1rem; cursor: pointer; transition: all 0.2s; }
    .btn-wishlist:hover { border-color: #ef4444; color: #ef4444; }
    .btn-wishlist.active { color: #ef4444; border-color: #ef4444; }
    
    .stock-msg { font-size: 0.8rem; color: var(--danger, #dc2626); margin-top: 4px; }

    /* Reviews Section */
    .reviews-card { margin-top: 64px; border: 1px solid var(--border); border-radius: 12px; background: var(--white); overflow: hidden; }
    .reviews-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; cursor: pointer; user-select: none; transition: background 0.2s; }
    .reviews-header:hover { background: var(--bg); }
    .rh-left { display: flex; align-items: center; gap: 12px; }
    .rh-title { font-size: 1.1rem; font-weight: 700; color: var(--text); }
    .rh-stars { color: #fbbf24; font-size: 1.1rem; letter-spacing: 2px; }
    .rh-count { font-size: 0.85rem; color: var(--muted); }
    .rh-arrow { transition: transform 0.3s; color: var(--muted); }
    
    .reviews-content { display: none; padding: 24px; border-top: 1px solid var(--border); }
    .reviews-content.open { display: block; }
    
    .rv-stats-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 32px; margin-bottom: 40px; }
    .rv-avg-box { text-align: center; display: flex; flex-direction: column; justify-content: center; background: var(--bg); border-radius: 8px; padding: 24px; }
    .rv-avg-num { font-size: 3rem; font-weight: 700; color: var(--text); line-height: 1; margin-bottom: 8px; }
    .rv-avg-stars { color: #fbbf24; font-size: 1.2rem; letter-spacing: 2px; margin-bottom: 8px; }
    
    .rv-bars { display: flex; flex-direction: column; gap: 8px; }
    .rv-bar-row { display: flex; align-items: center; gap: 12px; font-size: 0.85rem; color: var(--text); }
    .rv-bar-track { flex: 1; height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; }
    .rv-bar-fill { height: 100%; background: #fbbf24; border-radius: 4px; width: 0; }
    
    .review-item { padding: 20px 0; border-bottom: 1px solid var(--border); }
    .review-item:last-child { border-bottom: none; }
    .rv-user { display: flex; justify-content: space-between; margin-bottom: 8px; }
    .rv-name { font-weight: 600; font-size: 0.9rem; color: var(--text); }
    .rv-date { font-size: 0.8rem; color: var(--muted); }
    .rv-item-stars { color: #fbbf24; font-size: 0.9rem; margin-bottom: 8px; letter-spacing: 2px; }
    .rv-text { font-size: 0.9rem; color: var(--text); line-height: 1.5; }

    /* Review Form */
    .review-form-box { background: var(--bg); border-radius: 8px; padding: 24px; margin-bottom: 32px; }
    .review-form-box h4 { font-size: 1rem; font-weight: 700; margin-bottom: 16px; }
    .star-rating { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 4px; margin-bottom: 16px; }
    .star-rating input { display: none; }
    .star-rating label { font-size: 1.5rem; color: #d1d5db; cursor: pointer; transition: color 0.2s; }
    .star-rating input:checked ~ label, .star-rating label:hover, .star-rating label:hover ~ label { color: #fbbf24; }
    .review-form-box textarea { width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--white); font-family: inherit; font-size: 0.9rem; resize: vertical; margin-bottom: 16px; outline: none; }
    .review-form-box textarea:focus { border-color: var(--green); }
    .btn-submit-rv { padding: 10px 24px; background: var(--text); color: #fff; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .btn-submit-rv:hover { background: #000; }
    .btn-del-rv { background: none; border: none; color: #ef4444; font-size: 0.9rem; cursor: pointer; padding: 4px; opacity: 0.7; transition: opacity 0.2s; }
    .btn-del-rv:hover { opacity: 1; }

    .size-selector { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
    .size-btn { padding: 10px 24px; border: 1px solid var(--border); background: transparent; color: var(--text); font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: all 0.2s; font-family: inherit; }
    .size-btn:hover:not(:disabled) { border-color: var(--text); }
    .size-btn.selected { border-color: var(--text); background: var(--text); color: #fff; }
    .size-btn:disabled { opacity: 0.4; cursor: not-allowed; text-decoration: line-through; }

    @media (max-width: 768px) { 
        .pd-grid { grid-template-columns: 1fr; gap: 24px; } 
        .pd-section { padding: 24px 16px 48px; }
        .pd-gallery { position: relative; top: 0; }
        .pd-title { font-size: 1.6rem; }
        .pd-action-row { flex-wrap: wrap; }
        .qty-wrap { width: 100%; max-width: 100%; flex-direction: row; align-items: center; justify-content: space-between; }
        .btn-add-cart { flex: 1; min-width: 200px; }
        .rv-stats-grid { grid-template-columns: 1fr; gap: 24px; } 
        .reviews-header { flex-direction: column; align-items: flex-start; gap: 8px; }
        .rh-arrow { align-self: flex-end; margin-top: -24px; }
    }
</style>

<div class="pd-section">
    <div class="pd-grid">
        <!-- Gallery -->
        <div class="pd-gallery">
            <div class="pd-main-img">
                <% if (product.productImage && product.productImage.length > 0) { %>
                    <img id="mainImage" src="<%= product.productImage[0].startsWith('http') ? product.productImage[0] : '/uploads/product-images/' + product.productImage[0] %>" alt="<%= product.productName %>">
                <% } else { %>
                    <img src="/images/placeholder.jpg" alt="No image">
                <% } %>
                <button class="gal-nav prev" id="btnPrevImg"><i class="fa-solid fa-chevron-left"></i></button>
                <button class="gal-nav next" id="btnNextImg"><i class="fa-solid fa-chevron-right"></i></button>
            </div>
            <% if (product.productImage && product.productImage.length > 1) { %>
            <div class="pd-thumbs">
                <% product.productImage.forEach((img, idx) => { %>
                <div class="pd-thumb <%= idx === 0 ? 'active' : '' %>" data-idx="<%= idx %>" data-src="<%= img.startsWith('http') ? img : '/uploads/product-images/' + img %>">
                    <img src="<%= img.startsWith('http') ? img : '/uploads/product-images/' + img %>" alt="Thumb">
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>

        <!-- Info -->
        <div class="pd-info">
            <div>
                <h1 class="pd-title"><%= product.productName %></h1>
                <div class="pd-price-row">
                    <span class="pd-sale">₹<%= product.salePrice %></span>
                    <% if (product.regularPrice > product.salePrice) { %>
                    <span class="pd-reg">₹<%= product.regularPrice %></span>
                    <span class="pd-badge"><%= Math.round(((product.regularPrice - product.salePrice) / product.regularPrice) * 100) %>% OFF</span>
                    <% } %>
                    <% if (product.categoryOffer > 0) { %>
                    <span class="pd-badge" style="background:#f97316;">CAT <%= product.categoryOffer %>% OFF</span>
                    <% } %>
                </div>
                <p class="pd-desc"><%= product.description %></p>
            </div>

            <div class="pd-opt-group">
                <label class="pd-opt-label">Select Size</label>
                <div class="size-selector">
                    <% if (product.sizeVariants && product.sizeVariants.length > 0) { %>
                        <% product.sizeVariants.forEach(variant => { %>
                        <button type="button" class="size-btn" data-size="<%= variant.size %>" data-qty="<%= variant.quantity %>" <%= variant.quantity === 0 ? 'disabled' : '' %>>
                            <%= variant.size %>
                        </button>
                        <% }); %>
                    <% } %>
                </div>
                <input type="hidden" id="sizeSelect" name="size" value="">
            </div>

            <div class="pd-action-row">
                <div class="qty-wrap">
                    <div class="pd-opt-label">Quantity</div>
                    <div class="pd-qty-ctrl">
                        <button type="button" id="btnDecQty">−</button>
                        <input type="text" id="qtyInput" value="1" disabled>
                        <button type="button" id="btnIncQty">+</button>
                    </div>
                </div>
                <button type="button" id="btnAddToCart" class="btn-add-cart"><i class="fa-solid fa-cart-plus"></i> Add to Cart</button>
                <button type="button" id="btnWishlist" class="btn-wishlist <%= locals.user && isInWishlist ? 'active' : '' %>" data-pid="<%= product._id %>">
                    <i class="fa-solid fa-heart"></i>
                </button>
            </div>
            <div id="stockMsg" class="stock-msg"></div>
        </div>
    </div>

    <!-- Reviews -->
    <div class="reviews-card" data-pid="<%= product._id %>">
        <div class="reviews-header" id="rvToggle">
            <div class="rh-left">
                <span class="rh-title">Customer Reviews</span>
                <span class="rh-stars" id="rvHdrStars">★★★★★</span>
                <span class="rh-count" id="rvHdrCount">(0)</span>
            </div>
            <i class="fa-solid fa-chevron-down rh-arrow" id="rvArrow"></i>
        </div>
        
        <div class="reviews-content" id="rvContent">
            <div class="rv-stats-grid">
                <div class="rv-avg-box">
                    <div class="rv-avg-num" id="rvAvgNum">0.0</div>
                    <div class="rv-avg-stars" id="rvAvgStars">☆☆☆☆☆</div>
                    <div style="font-size:0.85rem;color:var(--muted);" id="rvTotalText">0 reviews</div>
                </div>
                <div class="rv-bars">
                    <% for(let i=5; i>=1; i--) { %>
                    <div class="rv-bar-row">
                        <span style="width:12px;"><%= i %></span> <span style="color:#fbbf24;">★</span>
                        <div class="rv-bar-track"><div class="rv-bar-fill" id="bar<%= i %>"></div></div>
                        <span style="width:24px;text-align:right;" id="cnt<%= i %>">0</span>
                    </div>
                    <% } %>
                </div>
            </div>

            <% if (locals.user && locals.canReview) { %>
            <div class="review-form-box">
                <h4>Write a Review</h4>
                <form id="rvForm">
                    <div class="star-rating">
                        <input type="radio" id="s5" name="rating" value="5"><label for="s5">★</label>
                        <input type="radio" id="s4" name="rating" value="4"><label for="s4">★</label>
                        <input type="radio" id="s3" name="rating" value="3"><label for="s3">★</label>
                        <input type="radio" id="s2" name="rating" value="2"><label for="s2">★</label>
                        <input type="radio" id="s1" name="rating" value="1"><label for="s1">★</label>
                    </div>
                    <textarea id="rvText" rows="3" placeholder="Share your experience..."></textarea>
                    <button type="submit" class="btn-submit-rv">Submit Review</button>
                </form>
            </div>
            <% } %>

            <div id="rvList">
                <div style="text-align:center;color:var(--muted);padding:20px;">Loading reviews...</div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/user/footer') %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Gallery
        const mainImg = document.getElementById('mainImage');
        const thumbs = document.querySelectorAll('.pd-thumb');
        let currentImgIdx = 0;

        function setMainImg(idx) {
            if (!thumbs.length) return;
            currentImgIdx = (idx + thumbs.length) % thumbs.length;
            thumbs.forEach((t, i) => {
                t.classList.toggle('active', i === currentImgIdx);
                if (i === currentImgIdx) mainImg.src = t.dataset.src;
            });
        }
        thumbs.forEach((t, i) => t.addEventListener('click', () => setMainImg(i)));
        document.getElementById('btnPrevImg')?.addEventListener('click', () => setMainImg(currentImgIdx - 1));
        document.getElementById('btnNextImg')?.addEventListener('click', () => setMainImg(currentImgIdx + 1));

        // Modern Zoom
        const mainImgContainer = document.querySelector('.pd-main-img');
        if (mainImgContainer && mainImg) {
            mainImgContainer.addEventListener('mousemove', (e) => {
                const { left, top, width, height } = mainImgContainer.getBoundingClientRect();
                const x = ((e.clientX - left) / width) * 100;
                const y = ((e.clientY - top) / height) * 100;
                mainImg.style.transformOrigin = `${x}% ${y}%`;
                mainImgContainer.classList.add('zoomed');
            });
            
            mainImgContainer.addEventListener('mouseleave', () => {
                mainImg.style.transformOrigin = 'center center';
                mainImgContainer.classList.remove('zoomed');
            });
        }

        // Add to Cart Logic
        const sizeSelect = document.getElementById('sizeSelect');
        const qtyInput = document.getElementById('qtyInput');
        const btnAdd = document.getElementById('btnAddToCart');
        const msg = document.getElementById('stockMsg');
        let maxQty = 0;
        function updateCartState() {
            if (!sizeSelect.value) {
                maxQty = 0; qtyInput.value = 1; btnAdd.disabled = false; msg.textContent = ''; return;
            }
            let q = parseInt(qtyInput.value) || 1;
            if (q < 1) q = 1;
            if (q > 5) q = 5;
            if (q > maxQty) q = maxQty;
            qtyInput.value = q;
            
            if (maxQty === 0) {
                btnAdd.disabled = true; msg.textContent = 'Out of stock';
            } else if (q > maxQty) {
                btnAdd.disabled = true; msg.textContent = `Only ${maxQty} available`;
            } else {
                btnAdd.disabled = false; msg.textContent = '';
            }
        }

        document.querySelectorAll('.size-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('selected'));
                this.classList.add('selected');
                sizeSelect.value = this.dataset.size;
                maxQty = parseInt(this.dataset.qty) || 0;
                qtyInput.value = 1;
                updateCartState();
            });
        });
        document.getElementById('btnDecQty').addEventListener('click', () => {
            if (!sizeSelect.value) {
                Swal.fire({title: 'Size Required', text: 'Please select a size first.', icon: 'warning', confirmButtonColor: '#111111'});
                return;
            }
            if (parseInt(qtyInput.value) > 1) { qtyInput.value = parseInt(qtyInput.value) - 1; updateCartState(); }
        });
        document.getElementById('btnIncQty').addEventListener('click', () => {
            if (!sizeSelect.value) {
                Swal.fire({title: 'Size Required', text: 'Please select a size first.', icon: 'warning', confirmButtonColor: '#111111'});
                return;
            }
            const cur = parseInt(qtyInput.value);
            if (cur < 5 && cur < maxQty) { qtyInput.value = cur + 1; updateCartState(); }
            else if (cur === 5) Swal.fire({title: 'Limit reached', text: 'Max 5 items per order', icon: 'warning', confirmButtonColor: '#111111'});
            else if (cur >= maxQty) Swal.fire({title: 'Stock Limit', text: `Only ${maxQty} items available in this size.`, icon: 'warning', confirmButtonColor: '#111111'});
        });

        btnAdd.addEventListener('click', async () => {
            if (!sizeSelect.value) {
                Swal.fire({title: 'Size Required', text: 'Please select a size to add to cart.', icon: 'warning', confirmButtonColor: '#111111'});
                return;
            }
            
            <% if (!locals.user) { %>
                window.location.href = `/signin?pendingAction=addCart&productId=<%= product._id %>&size=${encodeURIComponent(sizeSelect.value)}&quantity=${parseInt(qtyInput.value) || 1}`;
                return;
            <% } %>

            const payload = { productId: '<%= product._id %>', size: sizeSelect.value, quantity: parseInt(qtyInput.value) || 1 };
            try {
                const res = await fetch('/addCart', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload) });
                if (res.status === 401) { window.location.href = '/signin'; return; }
                const data = await res.json();
                if (data.success) {
                    Swal.fire({
                        title: 'Added to Wardrobe',
                        text: 'This item has been successfully added to your cart.',
                        icon: 'success',
                        showCancelButton: true,
                        confirmButtonText: 'View Cart',
                        cancelButtonText: 'Continue Shopping',
                        confirmButtonColor: '#111111',
                        cancelButtonColor: '#6b7280'
                    }).then((result) => {
                        if (result.isConfirmed) window.location.href = '/cart';
                    });
                } else { Swal.fire({title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#111111'}); }
            } catch (err) { window.location.href = '/signin'; }
        });

        // Wishlist
        const btnWish = document.getElementById('btnWishlist');
        btnWish.addEventListener('click', async () => {
            const size = sizeSelect.value;
            const qty = parseInt(qtyInput.value) || 1;
            const pid = btnWish.dataset.pid;

            if (!size) {
                Swal.fire({title: 'Size Required', text: 'Please select a size to add to wishlist.', icon: 'warning', confirmButtonColor: '#111111'});
                return;
            }
            
            <% if (!locals.user) { %>
                window.location.href = `/signin?pendingAction=addWishlist&productId=${pid}&size=${encodeURIComponent(size)}&quantity=${qty}`;
                return;
            <% } %>

            const isW = btnWish.classList.contains('active');
            const url = isW ? `/wishlist/remove/${pid}?size=${encodeURIComponent(size)}` : '/wishlist/add';
            const method = isW ? 'DELETE' : 'POST';
            try {
                const bodyObj = method==='POST' ? {productId:pid, size, quantity:qty} : null;
                const res = await fetch(url, { method, headers: {'Content-Type': 'application/json'}, body: bodyObj ? JSON.stringify(bodyObj) : null });
                if (res.status === 401) { window.location.href = '/signin'; return; }
                const data = await res.json();
                if (data.success) {
                    btnWish.classList.toggle('active');
                    Swal.fire({title: isW?'Removed':'Added to Wishlist', showConfirmButton: false, timer: 1200, icon: 'success'});
                }
            } catch (err) { window.location.href = '/signin'; }
        });

        // Reviews
        const rvToggle = document.getElementById('rvToggle');
        const rvContent = document.getElementById('rvContent');
        const rvArrow = document.getElementById('rvArrow');
        let rvLoaded = false;
        const pid = document.querySelector('.reviews-card').dataset.pid;
        const currentUserId = '<%= locals.user ? user._id : "" %>';

        rvToggle.addEventListener('click', () => {
            const open = rvContent.classList.toggle('open');
            rvArrow.style.transform = open ? 'rotate(180deg)' : 'rotate(0)';
            if (open && !rvLoaded) { loadReviews(); rvLoaded = true; }
        });

        async function loadReviews() {
            try {
                const res = await fetch(`/${pid}/reviews`);
                const data = await res.json();
                if (data.success) {
                    updateRvStats(data.stats);
                    const list = document.getElementById('rvList');
                    if (!data.reviews.length) { list.innerHTML = '<div style="text-align:center;color:#6b7280;padding:20px;">No reviews yet.</div>'; return; }
                    list.innerHTML = data.reviews.map(r => `
                        <div class="review-item">
                            <div class="rv-user" style="display:flex; justify-content:space-between; align-items:flex-start;">
                                <div><span class="rv-name">${r.userId.name}</span><span class="rv-date" style="margin-left:8px;">${new Date(r.createdAt).toLocaleDateString()}</span></div>
                                ${r.userId._id === currentUserId ? `<button type="button" class="btn-del-rv" onclick="deleteReview('${r._id}')"><i class="fa-solid fa-trash"></i></button>` : ''}
                            </div>
                            <div class="rv-item-stars">${'★'.repeat(r.rating)}${'☆'.repeat(5-r.rating)}</div>
                            <div class="rv-text">${r.review}</div>
                        </div>`).join('');
                }
            } catch(e) {}
        }
        
        window.deleteReview = function(reviewId) {
            Swal.fire({
                title: 'Delete Review?',
                text: "Are you sure you want to delete this?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#111111',
                confirmButtonText: 'Yes, delete it!'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`/reviews/${reviewId}`, { method: 'DELETE' });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire({title: 'Deleted!', icon: 'success', showConfirmButton: false, timer: 1500});
                            loadReviews();
                            if (document.getElementById('rvForm')) location.reload(); // Reload to show form again
                        } else {
                            Swal.fire({title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#111111'});
                        }
                    } catch(err) {
                        Swal.fire({title: 'Error', text: 'Failed to delete review', icon: 'error', confirmButtonColor: '#111111'});
                    }
                }
            });
        };
        function updateRvStats(s) {
            const avg = s.averageRating.toFixed(1);
            const stars = '★'.repeat(Math.round(s.averageRating)) + '☆'.repeat(5-Math.round(s.averageRating));
            document.getElementById('rvHdrStars').textContent = stars;
            document.getElementById('rvHdrCount').textContent = `(${s.totalReviews})`;
            document.getElementById('rvAvgNum').textContent = avg;
            document.getElementById('rvAvgStars').textContent = stars;
            document.getElementById('rvTotalText').textContent = `${s.totalReviews} reviews`;
            for(let i=1;i<=5;i++) {
                const pct = (s.ratingDistribution[i] / s.totalReviews * 100) || 0;
                document.getElementById(`bar${i}`).style.width = pct + '%';
                document.getElementById(`cnt${i}`).textContent = s.ratingDistribution[i];
            }
        }
        const rvForm = document.getElementById('rvForm');
        if (rvForm) {
            rvForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const rating = document.querySelector('input[name="rating"]:checked')?.value;
                const review = document.getElementById('rvText').value;
                if (!rating) { Swal.fire({title:'Rating required', icon:'warning', toast:true, position:'top-end', timer:2000, showConfirmButton:false}); return; }
                try {
                    Swal.fire({title:'Submitting...', allowOutsideClick:false, didOpen:()=>Swal.showLoading()});
                    const res = await fetch(`/${pid}/reviews`, { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({rating, review}) });
                    const data = await res.json();
                    if (data.success) {
                        Swal.fire({title:'Submitted', icon:'success', toast:true, position:'top-end', timer:2000, showConfirmButton:false});
                        rvForm.reset(); loadReviews();
                    } else { Swal.fire({title:'Error', text:data.message, icon:'error', confirmButtonColor:'#111111'}); }
                } catch(err) { Swal.fire({title:'Error', text:'Failed to submit', icon:'error', confirmButtonColor:'#111111'}); }
            });
        }
        loadReviews(); // Load stats on start for header
    });
</script>