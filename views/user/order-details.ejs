<%- include('../../views/partials/user/profilePartials/header.ejs') %>
    <% if(false) { %><!-- VSCode Linter Trick -->
        <html>

        <body>
            <div class="profile-layout">
                <main class="profile-main">
                    <% } %>


                        <script
                            src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

                        <style>
                            .od-header {
                                display: flex;
                                align-items: center;
                                justify-content: space-between;
                                margin-bottom: 24px;
                                padding-bottom: 16px;
                                border-bottom: 1px solid var(--border);
                            }

                            .od-title {
                                font-size: 1.4rem;
                                font-weight: 700;
                                color: var(--text);
                                margin: 0;
                            }

                            .btn-back {
                                display: inline-flex;
                                align-items: center;
                                gap: 8px;
                                color: var(--muted);
                                text-decoration: none;
                                font-size: 0.9rem;
                                font-weight: 500;
                                transition: color 0.2s;
                            }

                            .btn-back:hover {
                                color: var(--green);
                            }

                            .status-badge {
                                display: inline-block;
                                padding: 6px 12px;
                                border-radius: 6px;
                                font-size: 0.75rem;
                                font-weight: 700;
                                text-transform: uppercase;
                                letter-spacing: 0.5px;
                            }

                            .status-badge.pending {
                                background: #fef9c3;
                                color: #a16207;
                            }

                            .status-badge.processing {
                                background: #dbeafe;
                                color: #1d4ed8;
                            }

                            .status-badge.shipped {
                                background: #e0e7ff;
                                color: #4338ca;
                            }

                            .status-badge.delivered {
                                background: #dcfce7;
                                color: #15803d;
                            }

                            .status-badge.cancelled {
                                background: #fee2e2;
                                color: #b91c1c;
                            }

                            .status-badge.returned {
                                background: #f3f4f6;
                                color: #374151;
                            }

                            .od-grid {
                                display: grid;
                                grid-template-columns: 1fr 1fr;
                                gap: 24px;
                                margin-bottom: 32px;
                            }

                            .info-card {
                                background: var(--white);
                                border: 1px solid var(--border);
                                border-radius: 10px;
                                padding: 20px;
                            }

                            .info-card h3 {
                                font-size: 1rem;
                                font-weight: 700;
                                color: var(--text);
                                margin-bottom: 16px;
                                display: flex;
                                align-items: center;
                                gap: 8px;
                            }

                            .info-row {
                                display: flex;
                                margin-bottom: 8px;
                                font-size: 0.9rem;
                            }

                            .info-row .lbl {
                                width: 140px;
                                color: var(--muted);
                            }

                            .info-row .val {
                                flex: 1;
                                color: var(--text);
                                font-weight: 500;
                            }

                            .od-items-box {
                                background: var(--white);
                                border: 1px solid var(--border);
                                border-radius: 10px;
                                overflow: hidden;
                                margin-bottom: 32px;
                            }

                            .od-items-hdr {
                                padding: 16px 20px;
                                background: var(--bg);
                                border-bottom: 1px solid var(--border);
                                font-weight: 700;
                                font-size: 1rem;
                            }

                            .item-card {
                                display: flex;
                                gap: 16px;
                                padding: 20px;
                                border-bottom: 1px solid var(--border);
                                align-items: center;
                            }

                            .item-card:last-child {
                                border-bottom: none;
                            }

                            .item-card.cancelled {
                                opacity: 0.6;
                                background: #fafaf9;
                            }

                            .item-img {
                                width: 80px;
                                height: 80px;
                                border-radius: 8px;
                                object-fit: cover;
                                border: 1px solid var(--border);
                            }

                            .item-details {
                                flex: 1;
                            }

                            .item-name {
                                font-size: 0.95rem;
                                font-weight: 700;
                                color: var(--text);
                                margin-bottom: 4px;
                            }

                            .item-meta {
                                font-size: 0.85rem;
                                color: var(--muted);
                                margin-bottom: 8px;
                            }

                            .item-price-col {
                                text-align: right;
                                min-width: 120px;
                            }

                            .item-total {
                                font-weight: 700;
                                color: var(--text);
                                font-size: 1rem;
                            }

                            .od-summary {
                                background: var(--bg);
                                padding: 20px;
                                border-top: 1px solid var(--border);
                            }

                            .sum-row {
                                display: flex;
                                justify-content: flex-end;
                                gap: 40px;
                                margin-bottom: 8px;
                                font-size: 0.9rem;
                                color: var(--muted);
                            }

                            .sum-row.total {
                                font-size: 1.1rem;
                                font-weight: 700;
                                color: var(--text);
                                margin-top: 12px;
                                padding-top: 12px;
                                border-top: 1px solid var(--border);
                            }

                            .action-row {
                                display: flex;
                                gap: 12px;
                                justify-content: flex-end;
                                margin-top: 24px;
                            }

                            .btn-action {
                                padding: 10px 20px;
                                border-radius: 6px;
                                font-size: 0.9rem;
                                font-weight: 600;
                                cursor: pointer;
                                border: none;
                                font-family: inherit;
                                transition: all 0.2s;
                            }

                            .btn-invoice {
                                background: var(--white);
                                border: 1px solid var(--border);
                                color: var(--text);
                            }

                            .btn-invoice:hover {
                                border-color: var(--green);
                                color: var(--green);
                            }

                            .btn-cancel {
                                background: #fee2e2;
                                color: #b91c1c;
                            }

                            .btn-cancel:hover {
                                background: #fca5a5;
                            }

                            .btn-return {
                                background: var(--green);
                                color: #fff;
                            }

                            .btn-return:hover {
                                background: var(--green-dark);
                            }

                            .btn-cancel-item {
                                padding: 6px 12px;
                                font-size: 0.75rem;
                                background: #fee2e2;
                                color: #b91c1c;
                                border: none;
                                border-radius: 4px;
                                cursor: pointer;
                                font-weight: 600;
                            }

                            /* Return Modal */
                            .modal-overlay {
                                display: none;
                                position: fixed;
                                inset: 0;
                                background: rgba(0, 0, 0, 0.5);
                                z-index: 1000;
                                align-items: center;
                                justify-content: center;
                            }

                            .modal-overlay.active {
                                display: flex;
                            }

                            .modal-box {
                                background: var(--white);
                                padding: 24px;
                                border-radius: 12px;
                                width: 100%;
                                max-width: 400px;
                            }

                            .modal-box h3 {
                                margin-bottom: 16px;
                                font-size: 1.2rem;
                            }

                            .modal-box textarea {
                                width: 100%;
                                padding: 12px;
                                border: 1px solid var(--border);
                                border-radius: 8px;
                                margin-bottom: 16px;
                                font-family: inherit;
                                resize: vertical;
                                outline: none;
                            }

                            .modal-box textarea:focus {
                                border-color: var(--green);
                            }

                            @media (max-width: 768px) {
                                .od-grid {
                                    grid-template-columns: 1fr;
                                }

                                .item-card {
                                    flex-direction: column;
                                    align-items: flex-start;
                                }

                                .item-price-col {
                                    text-align: left;
                                    margin-top: 8px;
                                }
                            }
                        </style>

                        <div class="od-header">
                            <h1 class="od-title">Order #<%= order.orderId %>
                            </h1>
                            <a href="/orders" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Back to Orders</a>
                        </div>

                        <div
                            style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px;">
                            <div>
                                <span class="status-badge <%= order.status.toLowerCase() %>" id="mainStatusBadge">
                                    <%= order.status %>
                                </span>
                                <span style="font-size:0.85rem; color:var(--muted); margin-left:12px;"><i
                                        class="fa-regular fa-calendar"></i>
                                    <%= new Date(order.createdOn).toLocaleDateString() %>
                                </span>
                            </div>
                            <div class="action-row" style="margin:0;">
                                <% if (order.canDownloadInvoice) { %>
                                    <button class="btn-action btn-invoice"
                                        onclick="downloadInvoice('<%= order.orderId %>', this)"><i
                                            class="fa-solid fa-file-invoice"></i> Download Invoice</button>
                                    <% } %>
                                        <% if (order.status !=='Returned' && order.canCancel && order.status
                                            !=='Cancelled' ) { %>
                                            <button class="btn-action btn-cancel" id="btnCancelOrder"
                                                onclick="confirmCancelOrder('<%= order.orderId %>')">Cancel
                                                Order</button>
                                            <% } %>
                                                <% if (order.status==='Delivered' ) { %>
                                                    <button class="btn-action btn-return"
                                                        onclick="openReturnModal('<%= order.orderId %>')">Return
                                                        Order</button>
                                                    <% } %>
                            </div>
                        </div>

                        <div class="od-grid">
                            <div class="info-card">
                                <h3><i class="fa-solid fa-location-dot"></i> Shipping Details</h3>
                                <div class="info-row">
                                    <div class="lbl">Name</div>
                                    <div class="val">
                                        <%= order.address.name %>
                                    </div>
                                </div>
                                <div class="info-row">
                                    <div class="lbl">Address</div>
                                    <div class="val">
                                        <%= order.address.street %>, <%= order.address.city %>, <%= order.address.state
                                                    %> - <%= order.address.pincode %>
                                    </div>
                                </div>
                                <div class="info-row">
                                    <div class="lbl">Phone</div>
                                    <div class="val">
                                        <%= order.address.mobile %>
                                    </div>
                                </div>
                            </div>

                            <div class="info-card">
                                <h3><i class="fa-solid fa-credit-card"></i> Payment Details</h3>
                                <div class="info-row">
                                    <div class="lbl">Method</div>
                                    <div class="val" style="text-transform:uppercase;">
                                        <%= order.paymentMethod %>
                                    </div>
                                </div>
                                <div class="info-row">
                                    <div class="lbl">Status</div>
                                    <div class="val">
                                        <%= order.paymentStatus %>
                                    </div>
                                </div>
                                <% if (order.paymentMethod==='razorpay' && order.razorpayPaymentId) { %>
                                    <div class="info-row">
                                        <div class="lbl">Transaction ID</div>
                                        <div class="val">
                                            <%= order.razorpayPaymentId %>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                        </div>

                        <div class="od-items-box">
                            <div class="od-items-hdr">Order Items</div>

                            <% const sortedItems=[...order.orderedItems].sort((a, b)=> (a.status === 'Cancelled' ? 1 :
                                -1)); %>
                                <% sortedItems.forEach(item=> { %>
                                    <div class="item-card <%= item.status === 'Cancelled' ? 'cancelled' : '' %>"
                                        id="item-<%= item._id %>">
                                        <img src="<%= (item.product && item.product.productImage && item.product.productImage[0] && item.product.productImage[0].startsWith('http')) ? item.product.productImage[0] : '/uploads/product-images/' + (item.product ? item.product.productImage[0] : '') %>"
                                            alt="<%= item.product ? item.product.productName : 'Product' %>"
                                            class="item-img" style="cursor: pointer;"
                                            onclick="goToProduct('<%= item.product?._id || '' %>')"
                                            onerror="this.src='/images/placeholder.jpg'">
                                        <div class="item-details">
                                            <div class="item-name"
                                                style="cursor: pointer; text-decoration: underline; text-underline-offset: 2px; width: fit-content;"
                                                onclick="goToProduct('<%= item.product?._id || '' %>')">
                                                <%= item.product ? item.product.productName : 'Product Unavailable' %>
                                            </div>
                                            <div class="item-meta">Size: <%= item.size %> | Qty: <%= item.quantity %>
                                            </div>

                                            <% if (item.status==='Cancelled' ) { %>
                                                <span class="status-badge cancelled">Item Cancelled</span>
                                                <% } else if (order.canCancel) { %>
                                                    <button class="btn-cancel-item"
                                                        onclick="confirmCancelItem('<%= order.orderId %>', '<%= item._id %>')">Cancel
                                                        Item</button>
                                                    <% } %>
                                        </div>
                                        <div class="item-price-col">
                                            <div style="font-size:0.85rem;color:var(--muted);margin-bottom:4px;">₹<%=
                                                    (item.price/item.quantity).toFixed(2) %> each</div>
                                            <div class="item-total">₹<%= item.price.toFixed(2) %>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>

                                        <div class="od-summary">
                                            <% const activeItems=order.orderedItems.filter(item=> item.status !==
                                                'Cancelled'); %>
                                                <% const subtotal=activeItems.reduce((sum, item)=> sum + item.price, 0);
                                                    %>
                                                    <div class="sum-row" id="sumSub"><span>Subtotal</span><span>₹<%=
                                                                subtotal.toFixed(2) %></span></div>
                                                    <% if (order.discount> 0) { %>
                                                        <div class="sum-row"><span>Discount</span><span
                                                                style="color:#10b981;">-₹<%= order.discount.toFixed(2)
                                                                    %></span></div>
                                                        <% } %>
                                                            <div class="sum-row total" id="sumTotal"><span>Total
                                                                    Amount</span><span>₹<%= order.finalAmount.toFixed(2)
                                                                        %></span></div>
                                        </div>
                        </div>

                        <!-- Return Modal -->
                        <div class="modal-overlay" id="returnModal">
                            <div class="modal-box">
                                <h3>Return Order</h3>
                                <textarea id="returnReason" rows="4"
                                    placeholder="Please explain the reason for return..."></textarea>
                                <div style="display:flex;gap:12px;justify-content:flex-end;">
                                    <button class="btn-action btn-invoice"
                                        onclick="document.getElementById('returnModal').classList.remove('active')">Cancel</button>
                                    <button class="btn-action btn-return" onclick="submitReturn()">Submit
                                        Request</button>
                                </div>
                            </div>
                        </div>


                        <script>
                            async function goToProduct(productId) {
                                if (!productId || productId === 'undefined') {
                                    Swal.fire({ title: 'Product Unavailable', text: 'This product has been removed from our catalog.', icon: 'error', confirmButtonColor: '#111111' });
                                    return;
                                }
                                try {
                                    const response = await fetch(`/productDetails?id=${productId}`, { method: 'HEAD' });
                                    if (response.redirected && response.url.includes('/shop')) {
                                        Swal.fire({ title: 'Product Unavailable', text: 'This product is currently unavailable or out of stock.', icon: 'error', confirmButtonColor: '#111111' });
                                    } else {
                                        window.location.href = `/productDetails?id=${productId}`;
                                    }
                                } catch (e) {
                                    window.location.href = `/productDetails?id=${productId}`;
                                }
                            }

                            // Cancel Order
                            async function confirmCancelOrder(orderId) {
                                const { value: reason } = await Swal.fire({
                                    title: 'Cancel Order',
                                    html: `
                <style>
                    .cancel-radio-group { display: flex; flex-direction: column; gap: 8px; text-align: left; margin-bottom: 12px; }
                    .cancel-radio-label { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; transition: all 0.2s; font-size: 0.9rem; color: var(--text); background: var(--bg); }
                    .cancel-radio-label:hover { border-color: var(--green); }
                    .cancel-radio-input { appearance: none; -webkit-appearance: none; width: 18px; height: 18px; border: 2px solid var(--muted); border-radius: 50%; margin: 0; outline: none; cursor: pointer; position: relative; transition: border-color 0.2s; }
                    .cancel-radio-input:checked { border-color: var(--green); }
                    .cancel-radio-input:checked::after { content: ''; position: absolute; top: 3px; left: 3px; width: 8px; height: 8px; background: var(--green); border-radius: 50%; }
                    .cancel-radio-input:checked + span { font-weight: 600; color: var(--green); }
                    .cancel-radio-label:has(input:checked) { border-color: var(--green); background: rgba(74,82,37,0.04); }
                </style>
                <div class="cancel-radio-group" id="swal-cancel-reason-group">
                    <label class="cancel-radio-label">
                        <input type="radio" name="cancel_reason" value="Changed my mind" class="cancel-radio-input" onchange="document.getElementById('swal-cancel-other').style.display='none'">
                        <span>Changed my mind</span>
                    </label>
                    <label class="cancel-radio-label">
                        <input type="radio" name="cancel_reason" value="Ordered by mistake" class="cancel-radio-input" onchange="document.getElementById('swal-cancel-other').style.display='none'">
                        <span>Ordered by mistake</span>
                    </label>
                    <label class="cancel-radio-label">
                        <input type="radio" name="cancel_reason" value="Found a better price elsewhere" class="cancel-radio-input" onchange="document.getElementById('swal-cancel-other').style.display='none'">
                        <span>Found a better price elsewhere</span>
                    </label>
                    <label class="cancel-radio-label">
                        <input type="radio" name="cancel_reason" value="Expected delivery time is too long" class="cancel-radio-input" onchange="document.getElementById('swal-cancel-other').style.display='none'">
                        <span>Delivery time is too long</span>
                    </label>
                    <label class="cancel-radio-label">
                        <input type="radio" name="cancel_reason" value="Other" class="cancel-radio-input" onchange="document.getElementById('swal-cancel-other').style.display='block'">
                        <span>Other (Please specify)</span>
                    </label>
                </div>
                <textarea id="swal-cancel-other" class="swal2-textarea" style="display:none; width:100%; box-sizing:border-box; margin-top:0;" placeholder="Please specify your reason..."></textarea>
            `,
                                    showCancelButton: true,
                                    confirmButtonColor: '#b91c1c',
                                    cancelButtonColor: '#6b7280',
                                    confirmButtonText: 'Yes, cancel it!',
                                    preConfirm: () => {
                                        const checked = document.querySelector('input[name="cancel_reason"]:checked');
                                        const select = checked ? checked.value : '';
                                        const other = document.getElementById('swal-cancel-other').value;
                                        if (!select) { Swal.showValidationMessage('Please select a reason!'); return false; }
                                        if (select === 'Other' && !other.trim()) { Swal.showValidationMessage('Please specify your reason!'); return false; }
                                        return select === 'Other' ? other.trim() : select;
                                    }
                                });

                                if (reason) {
                                    try {
                                        Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                                        const res = await fetch(`/orders/${orderId}/cancel`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason }) });
                                        const data = await res.json();
                                        if (data.success) {
                                            Swal.fire({ title: 'Cancelled!', text: 'Order cancelled successfully.', icon: 'success' }).then(() => location.reload());
                                        } else throw new Error(data.message);
                                    } catch (e) { Swal.fire({ title: 'Error', text: e.message || 'Failed to cancel', icon: 'error' }); }
                                }
                            }

                            // Cancel Item
                            async function confirmCancelItem(orderId, itemId) {
                                const { value: reason } = await Swal.fire({
                                    title: 'Cancel Item',
                                    html: `
                <style>
                    .cancel-radio-group { display: flex; flex-direction: column; gap: 8px; text-align: left; margin-bottom: 12px; }
                    .cancel-radio-label { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; transition: all 0.2s; font-size: 0.9rem; color: var(--text); background: var(--bg); }
                    .cancel-radio-label:hover { border-color: var(--green); }
                    .cancel-radio-input { appearance: none; -webkit-appearance: none; width: 18px; height: 18px; border: 2px solid var(--muted); border-radius: 50%; margin: 0; outline: none; cursor: pointer; position: relative; transition: border-color 0.2s; }
                    .cancel-radio-input:checked { border-color: var(--green); }
                    .cancel-radio-input:checked::after { content: ''; position: absolute; top: 3px; left: 3px; width: 8px; height: 8px; background: var(--green); border-radius: 50%; }
                    .cancel-radio-input:checked + span { font-weight: 600; color: var(--green); }
                    .cancel-radio-label:has(input:checked) { border-color: var(--green); background: rgba(74,82,37,0.04); }
                </style>
                <div class="cancel-radio-group" id="swal-cancel-item-reason-group">
                    <label class="cancel-radio-label">
                        <input type="radio" name="cancel_item_reason" value="Changed my mind" class="cancel-radio-input" onchange="document.getElementById('swal-cancel-item-other').style.display='none'">
                        <span>Changed my mind</span>
                    </label>
                    <label class="cancel-radio-label">
                        <input type="radio" name="cancel_item_reason" value="Ordered by mistake" class="cancel-radio-input" onchange="document.getElementById('swal-cancel-item-other').style.display='none'">
                        <span>Ordered by mistake</span>
                    </label>
                    <label class="cancel-radio-label">
                        <input type="radio" name="cancel_item_reason" value="Found a better price elsewhere" class="cancel-radio-input" onchange="document.getElementById('swal-cancel-item-other').style.display='none'">
                        <span>Found a better price elsewhere</span>
                    </label>
                    <label class="cancel-radio-label">
                        <input type="radio" name="cancel_item_reason" value="Expected delivery time is too long" class="cancel-radio-input" onchange="document.getElementById('swal-cancel-item-other').style.display='none'">
                        <span>Delivery time is too long</span>
                    </label>
                    <label class="cancel-radio-label">
                        <input type="radio" name="cancel_item_reason" value="Other" class="cancel-radio-input" onchange="document.getElementById('swal-cancel-item-other').style.display='block'">
                        <span>Other (Please specify)</span>
                    </label>
                </div>
                <textarea id="swal-cancel-item-other" class="swal2-textarea" style="display:none; width:100%; box-sizing:border-box; margin-top:0;" placeholder="Please specify your reason..."></textarea>
            `,
                                    showCancelButton: true,
                                    confirmButtonColor: '#b91c1c',
                                    cancelButtonColor: '#6b7280',
                                    confirmButtonText: 'Yes, cancel item!',
                                    preConfirm: () => {
                                        const checked = document.querySelector('input[name="cancel_item_reason"]:checked');
                                        const select = checked ? checked.value : '';
                                        const other = document.getElementById('swal-cancel-item-other').value;
                                        if (!select) { Swal.showValidationMessage('Please select a reason!'); return false; }
                                        if (select === 'Other' && !other.trim()) { Swal.showValidationMessage('Please specify your reason!'); return false; }
                                        return select === 'Other' ? other.trim() : select;
                                    }
                                });

                                if (reason) {
                                    try {
                                        Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                                        const res = await fetch(`/orders/${orderId}/items/${itemId}/cancel`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason }) });
                                        const data = await res.json();
                                        if (data.success) {
                                            const ic = document.getElementById(`item-${itemId}`);
                                            ic.classList.add('cancelled');
                                            const btn = ic.querySelector('.btn-cancel-item');
                                            if (btn) {
                                                const bdg = document.createElement('span'); bdg.className = 'status-badge cancelled'; bdg.textContent = 'Item Cancelled';
                                                btn.replaceWith(bdg);
                                            }
                                            if (data.updatedOrder.isFullyCancelled) {
                                                document.getElementById('mainStatusBadge').className = 'status-badge cancelled';
                                                document.getElementById('mainStatusBadge').textContent = 'Cancelled';
                                                const cbtn = document.getElementById('btnCancelOrder'); if (cbtn) cbtn.style.display = 'none';
                                                document.querySelectorAll('.btn-cancel-item').forEach(b => b.style.display = 'none');
                                            }
                                            document.getElementById('sumSub').querySelector('span:last-child').textContent = `₹${data.updatedOrder.totalPrice.toFixed(2)}`;
                                            document.getElementById('sumTotal').querySelector('span:last-child').textContent = `₹${data.updatedOrder.finalAmount.toFixed(2)}`;
                                            Swal.fire({ title: 'Item Cancelled', icon: 'success', toast: true, position: 'top-end', timer: 2000, showConfirmButton: false });
                                        } else throw new Error(data.message);
                                    } catch (e) { Swal.fire({ title: 'Error', text: e.message || 'Failed to cancel item', icon: 'error' }); }
                                }
                            }

                            // Return logic
                            const retMod = document.getElementById('returnModal');
                            let retOrderId = '';
                            function openReturnModal(oid) { retOrderId = oid; retMod.classList.add('active'); }
                            async function submitReturn() {
                                const rsn = document.getElementById('returnReason').value;
                                if (!rsn.trim()) { Swal.fire({ title: 'Error', text: 'Reason is required', icon: 'warning' }); return; }
                                try {
                                    Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                                    const res = await fetch('/submit-return', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderId: retOrderId, returnReason: rsn }) });
                                    const data = await res.json();
                                    if (data.success) {
                                        Swal.fire({ title: 'Return Requested', icon: 'success' }).then(() => location.reload());
                                    } else throw new Error(data.message);
                                } catch (e) { Swal.fire({ title: 'Error', text: e.message || 'Failed to request return', icon: 'error' }); }
                            }

                            // Invoice Logic
                            async function downloadInvoice(orderId, btn) {
                                const ogText = btn.innerHTML;
                                try {
                                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generating...'; btn.disabled = true;
                                    const res = await fetch(`/orders/${orderId}/invoice`);
                                    const data = await res.json();
                                    if (!data.success) throw new Error(data.message);

                                    const { order } = data;
                                    const addr = order.address || { name: 'N/A', street: 'N/A', city: 'N/A', state: 'N/A', pincode: 'N/A', mobile: 'N/A' };

                                    const html = `
                <div style="padding:40px; font-family:sans-serif; color:#1a1a1a;">
                    <div style="text-align:center; margin-bottom:40px; border-bottom:1px solid #e5e7eb; padding-bottom:20px;">
                        <h1 style="margin:0; font-size:28px;">Brossoc Invoice</h1>
                    </div>
                    <div style="display:flex; justify-content:space-between; margin-bottom:30px;">
                        <div>
                            <strong>Order ID:</strong> ${order.orderId}<br>
                            <strong>Date:</strong> ${new Date(order.orderDate).toLocaleDateString()}<br>
                            <strong>Payment:</strong> ${order.paymentMethod.toUpperCase()} (${order.paymentStatus})
                        </div>
                        <div style="text-align:right;">
                            <strong>Billed To:</strong><br>
                            ${addr.name}<br>${addr.street}, ${addr.city}<br>${addr.state} - ${addr.pincode}<br>Ph: ${addr.mobile}
                        </div>
                    </div>
                    <table style="width:100%; border-collapse:collapse; margin-bottom:30px;">
                        <tr style="background:#f3f4f6; text-align:left;">
                            <th style="padding:10px; border:1px solid #e5e7eb;">Item</th>
                            <th style="padding:10px; border:1px solid #e5e7eb;">Size</th>
                            <th style="padding:10px; border:1px solid #e5e7eb;">Qty</th>
                            <th style="padding:10px; border:1px solid #e5e7eb;">Price</th>
                            <th style="padding:10px; border:1px solid #e5e7eb;">Total</th>
                        </tr>
                        ${order.orderedItems.filter(i => i.status !== 'Cancelled').map(i => `
                        <tr>
                            <td style="padding:10px; border:1px solid #e5e7eb;">${i.product?.productName || 'Product'}</td>
                            <td style="padding:10px; border:1px solid #e5e7eb;">${i.size}</td>
                            <td style="padding:10px; border:1px solid #e5e7eb;">${i.quantity}</td>
                            <td style="padding:10px; border:1px solid #e5e7eb;">₹${(i.price / i.quantity).toFixed(2)}</td>
                            <td style="padding:10px; border:1px solid #e5e7eb;">₹${i.price.toFixed(2)}</td>
                        </tr>
                        `).join('')}
                    </table>
                    <div style="text-align:right; font-size:16px;">
                        <div style="margin-bottom:8px;">Subtotal: ₹${order.totalPrice.toFixed(2)}</div>
                        ${order.discount > 0 ? `<div style="margin-bottom:8px;color:#10b981;">Discount: -₹${order.discount.toFixed(2)}</div>` : ''}
                        <div style="font-size:20px; font-weight:bold; margin-top:12px; padding-top:12px; border-top:2px solid #e5e7eb;">
                            Final Amount: ₹${order.finalAmount.toFixed(2)}
                        </div>
                    </div>
                </div>
            `;
                                    const el = document.createElement('div'); el.innerHTML = html; document.body.appendChild(el);
                                    await html2pdf().set({ margin: 0.5, filename: `Invoice_${order.orderId}.pdf`, image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' } }).from(el).save();
                                    document.body.removeChild(el);
                                } catch (e) { Swal.fire({ title: 'Error', text: 'Failed to download invoice', icon: 'error' }); }
                                finally { btn.innerHTML = ogText; btn.disabled = false; }
                            }
                        </script>
                </main>
            </div>
        </body>

        </html>