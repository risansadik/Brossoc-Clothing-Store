<%- include('../../views/partials/user/profilePartials/header.ejs') %>
<% if(false) { %><!-- VSCode Linter Trick --><html><body><div class="profile-layout"><main class="profile-main"><% } %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.css">


<style>
    :root { --green: #4a5225; --bg: #f4f5f3; --white: #fff; --border: #e2e5e0; --text: #1a1a1a; --muted: #6b7280; }
    .header-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .btn-add { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; background: var(--green); color: #fff; border: none; border-radius: 8px; font-family: inherit; font-size: 0.88rem; font-weight: 600; text-decoration: none; cursor: pointer; transition: background 0.2s; }
    .btn-add:hover { background: #3a411d; }
    .addr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
    .addr-card { background: var(--white); border: 1px solid var(--border); border-radius: 10px; padding: 20px; position: relative; }
    .addr-delete { position: absolute; top: 14px; right: 14px; color: #e53e3e; cursor: pointer; font-size: 0.9rem; background: none; border: none; padding: 4px; transition: color 0.2s; }
    .addr-delete:hover { color: #b91c1c; }
    .addr-label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); margin-bottom: 4px; }
    .addr-value { font-size: 0.93rem; color: var(--text); margin-bottom: 12px; line-height: 1.5; }
    .btn-edit-addr { display: block; width: 100%; padding: 10px; background: transparent; border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-family: inherit; font-size: 0.88rem; font-weight: 600; text-align: center; text-decoration: none; cursor: pointer; transition: all 0.2s; margin-top: 12px; }
    .btn-edit-addr:hover { background: var(--bg); border-color: var(--green); color: var(--green); }
    .empty-state { text-align: center; padding: 40px 20px; color: var(--muted); }
    .empty-state i { font-size: 2rem; margin-bottom: 12px; display: block; }
</style>

<div class="header-bar">
    <h2 class="page-title" style="margin-bottom:0;">My Addresses</h2>
    <a href="/addAddress" class="btn-add"><i class="fa-solid fa-plus"></i> Add Address</a>
</div>

<% if (addresses && addresses.length > 0) { %>
<div class="addr-grid">
    <% addresses.forEach((address, index) => { %>
    <div class="addr-card">
        <button class="addr-delete" onclick="confirmDelete('<%= index %>', event)" title="Remove"><i class="fa-solid fa-xmark"></i></button>

        <div class="addr-label">Full Name</div>
        <div class="addr-value"><%= address.name %></div>

        <div class="addr-label">Address</div>
        <div class="addr-value"><%= address.landmark %><br><%= address.city %>, <%= address.state %> &mdash; <%= address.pincode %></div>

        <div class="addr-label">Phone</div>
        <div class="addr-value"><%= address.phone %> <% if (address.altPhone) { %> &middot; Alt: <%= address.altPhone %><% } %></div>

        <a href="/editAddress/<%= index %>" class="btn-edit-addr">Edit Address</a>
    </div>
    <% }); %>
</div>
<% } else { %>
<div class="card">
    <div class="empty-state">
        <i class="fa-regular fa-map"></i>
        <p>No saved addresses yet.</p>
        <a href="/addAddress" class="btn-add" style="display:inline-flex;margin-top:16px;"><i class="fa-solid fa-plus"></i> Add Address</a>
    </div>
</div>
<% } %>

<script>

    function confirmDelete(addressIndex, event) {
        event.preventDefault();
        Swal.fire({ title: 'Remove address?', text: "This can't be undone.", icon: 'warning', showCancelButton: true, confirmButtonColor: '#4a5225', cancelButtonColor: '#6b7280', confirmButtonText: 'Yes, remove' }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/deleteAddress/${addressIndex}`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, credentials: 'include' })
                .then(r => r.json()).then(data => {
                    if (data.success) { Swal.fire({ title: 'Removed!', icon: 'success', timer: 1500, showConfirmButton: false }).then(() => location.reload()); }
                }).catch(() => Swal.fire({ title: 'Error!', text: 'Something went wrong.', icon: 'error' }));
            }
        });
    }
</script>

        </main>
    </div>
</body>
</html>