<%- include('../partials/user/header') %>


<style>
    .contact-hero { background: var(--bg); padding: 64px 24px; text-align: center; border-bottom: 1px solid var(--border); }
    .contact-hero h1 { font-size: 2.5rem; font-weight: 700; color: var(--text); margin-bottom: 16px; letter-spacing: -0.5px; }
    .contact-hero p { font-size: 1.1rem; color: var(--muted); max-width: 500px; margin: 0 auto; }
    
    .contact-section { max-width: 1000px; margin: 0 auto; padding: 64px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
    
    .info-list { display: flex; flex-direction: column; gap: 32px; }
    .info-item { display: flex; align-items: flex-start; gap: 16px; }
    .info-icon { width: 48px; height: 48px; background: var(--green-light); color: var(--green); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
    .info-text h4 { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 4px; }
    .info-text p { font-size: 0.95rem; color: var(--muted); line-height: 1.5; }
    
    .contact-form { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
    .contact-form h3 { font-size: 1.2rem; font-weight: 700; margin-bottom: 24px; color: var(--text); }
    .form-grp { margin-bottom: 16px; }
    .form-grp label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--text); margin-bottom: 6px; }
    .form-grp input, .form-grp textarea { width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); font-family: inherit; font-size: 0.95rem; outline: none; transition: border-color 0.2s; }
    .form-grp input:focus, .form-grp textarea:focus { border-color: var(--green); background: var(--white); }
    .btn-submit { width: 100%; padding: 14px; background: var(--green); color: #fff; border: none; border-radius: 8px; font-weight: 600; font-size: 0.95rem; cursor: pointer; transition: background 0.2s; }
    .btn-submit:hover { background: var(--green-dark); }

    @media (max-width: 768px) { .contact-section { grid-template-columns: 1fr; gap: 40px; } }
</style>

<div class="contact-hero">
    <h1>Contact Us</h1>
    <p>Have a question or need assistance? Our team is here to help you.</p>
</div>

<div class="contact-section">
    <div>
        <div class="info-list">
            <div class="info-item">
                <div class="info-icon"><i class="fa-solid fa-location-dot"></i></div>
                <div class="info-text">
                    <h4>Visit Us</h4>
                    <p>Brossoc Headquarters<br>123 Fashion Avenue<br>Mumbai, India 400001</p>
                </div>
            </div>
            <div class="info-item">
                <div class="info-icon"><i class="fa-solid fa-envelope"></i></div>
                <div class="info-text">
                    <h4>Email Us</h4>
                    <p>support@brossoc.com<br>info@brossoc.com</p>
                </div>
            </div>
            <div class="info-item">
                <div class="info-icon"><i class="fa-solid fa-phone"></i></div>
                <div class="info-text">
                    <h4>Call Us</h4>
                    <p>+91 98765 43210<br>Mon-Sat, 9AM to 6PM</p>
                </div>
            </div>
        </div>
    </div>
    
    <div>
        <form class="contact-form" id="contactForm">
            <h3>Send a Message</h3>
            <div class="form-grp">
                <label>Full Name</label>
                <input type="text" id="cName" placeholder="Your name" required>
            </div>
            <div class="form-grp">
                <label>Email Address</label>
                <input type="email" id="cEmail" placeholder="Your email" required>
            </div>
            <div class="form-grp">
                <label>Message</label>
                <textarea id="cMessage" rows="4" placeholder="How can we help?" required></textarea>
            </div>
            <button type="submit" class="btn-submit">Send Message</button>
        </form>
    </div>
</div>

<%- include('../partials/user/footer') %>

<script>
    document.getElementById('contactForm').addEventListener('submit', (e) => {
        e.preventDefault();
        Swal.fire({ title: 'Message Sent!', text: 'We will get back to you shortly.', icon: 'success', confirmButtonColor: '#4a5225' });
        e.target.reset();
    });
</script>