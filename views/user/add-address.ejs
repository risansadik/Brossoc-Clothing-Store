<%- include('../../views/partials/user/profilePartials/header.ejs') %>
<% if(false) { %><!-- VSCode Linter Trick --><html><body><div class="profile-layout"><main class="profile-main"><% } %>

<style>
    :root { --green: #4a5225; --bg: #f4f5f3; --white: #fff; --border: #e2e5e0; --text: #1a1a1a; --muted: #6b7280; --danger: #dc2626; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group.full { grid-column: 1/-1; }
    .form-group label { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
    .form-group label .req { color: var(--danger); }
    .form-group input { padding: 11px 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); font-family: inherit; font-size: 0.93rem; transition: border-color 0.2s, box-shadow 0.2s; }
    .form-group input:focus { outline: none; border-color: var(--green); background: var(--white); box-shadow: 0 0 0 3px rgba(59,93,80,0.1); }
    .form-group input.error { border-color: var(--danger); }
    .error-message { color: var(--danger); font-size: 0.75rem; display: none; }
    .btn-row { display: flex; gap: 10px; margin-top: 20px; }
    .btn-save { padding: 11px 24px; background: var(--green); color: #fff; border: none; border-radius: 8px; font-family: inherit; font-size: 0.93rem; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .btn-save:hover { background: #3a411d; }
    .btn-cancel { padding: 11px 20px; background: transparent; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.93rem; font-weight: 500; color: var(--muted); text-decoration: none; cursor: pointer; }
    @media (max-width: 520px) { .form-grid { grid-template-columns: 1fr; } .form-group.full { grid-column: 1; } }
</style>

<h2 class="page-title">Add New Address</h2>

<div class="card">
    <form id="addressForm" action="/address/add<%= typeof returnTo !== 'undefined' && returnTo ? '?returnTo=' + returnTo : '' %>" method="POST" onsubmit="return validateForm(event)">
        <div class="form-grid">
            <div class="form-group">
                <label>Address Type <span class="req">*</span></label>
                <input type="text" name="addressType" placeholder="Home, Work, etc.">
                <div class="error-message">This field cannot be empty</div>
            </div>
            <div class="form-group">
                <label>Full Name <span class="req">*</span></label>
                <input type="text" name="name" placeholder="Recipient's name">
                <div class="error-message">This field cannot be empty</div>
            </div>
            <div class="form-group full">
                <label>Street Address / Landmark <span class="req">*</span></label>
                <input type="text" name="landmark" placeholder="Street, area, landmark">
                <div class="error-message">This field cannot be empty</div>
            </div>
            <div class="form-group">
                <label>City <span class="req">*</span></label>
                <input type="text" name="city" placeholder="City">
                <div class="error-message">This field cannot be empty</div>
            </div>
            <div class="form-group">
                <label>State <span class="req">*</span></label>
                <input type="text" name="state" placeholder="State">
                <div class="error-message">This field cannot be empty</div>
            </div>
            <div class="form-group">
                <label>PIN Code <span class="req">*</span></label>
                <input type="text" name="pincode" placeholder="6-digit PIN" pattern="[0-9]{6}">
                <div class="error-message">Enter a valid 6-digit PIN code</div>
            </div>
            <div class="form-group">
                <label>Phone Number <span class="req">*</span></label>
                <input type="tel" name="phone" placeholder="10-digit number" pattern="[0-9]{10}">
                <div class="error-message">Enter a valid 10-digit phone number</div>
            </div>
            <div class="form-group">
                <label>Alternative Phone</label>
                <input type="tel" name="altPhone" placeholder="Optional">
                <div class="error-message">Enter a valid 10-digit phone number</div>
            </div>
        </div>
        <div class="btn-row">
            <button type="submit" class="btn-save">Save Address</button>
            <a href="<%= typeof returnTo !== 'undefined' && returnTo === 'checkout' ? '/checkout' : '/addresses' %>" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>

<script>

    function validateForm(event) {
        event.preventDefault();
        let isValid = true;
        const form = document.getElementById('addressForm');
        const inputs = form.querySelectorAll('input[type="text"], input[type="tel"]');
        inputs.forEach(input => {
            input.classList.remove('error');
            input.nextElementSibling.style.display = 'none';
            if (input.value.trim() === '' && input.name !== 'altPhone') { input.classList.add('error'); input.nextElementSibling.style.display = 'block'; isValid = false; }
            if (input.name === 'pincode' && !/^\d{6}$/.test(input.value)) { input.classList.add('error'); input.nextElementSibling.style.display = 'block'; isValid = false; }
            if (input.name === 'phone' && !/^\d{10}$/.test(input.value)) { input.classList.add('error'); input.nextElementSibling.style.display = 'block'; isValid = false; }
            if (input.name === 'altPhone' && input.value && !/^\d{10}$/.test(input.value)) { input.classList.add('error'); input.nextElementSibling.style.display = 'block'; isValid = false; }
        });
        if (isValid) form.submit();
        return isValid;
    }
    document.querySelectorAll('input').forEach(input => {
        input.addEventListener('input', function () { if (this.value.trim()) { this.classList.remove('error'); this.nextElementSibling.style.display = 'none'; } });
    });
</script>

        </main>
    </div>
</body>
</html>